---
import type { Window } from '../types/agg';
import { utcStamp, windowLabel } from '../lib/format';
import { NON_ENDORSEMENT_TEXT, TRADEMARK_TEXT } from '../lib/legal';
import { siteData } from '../lib/site';

interface Props {
  patch: string;
  generatedAt?: string;
  sourceWindow?: Window;
}

const { patch, generatedAt, sourceWindow } = Astro.props;

// The data state is read from the manifest rather than taken as a prop: the
// Props interface above is the frozen component API, and the footer's provenance
// line must not be able to disagree with the banner at the top of the same page.
const state = siteData().state;

// The four compliance links. They are part of the Riot compliance surface, so
// they are rendered unconditionally and no page can drop them.
//
// The non-endorsement block below renders the frozen sentences from
// web/src/lib/legal.ts verbatim rather than carrying its own wording. A
// paraphrase here would be a second, weaker statement of the same notice served
// on more pages than the real one, which is exactly the drift the invariant in
// legal.ts forbids; scripts/compliance-check.sh check 6 now fails if this file
// stops reading the constant.
const links = [
  { href: '/about', label: 'About' },
  { href: '/legal/terms', label: 'Terms' },
  { href: '/legal/privacy', label: 'Privacy' },
  { href: '/disclaimer', label: 'Disclaimer' },
];
---

<footer class="ds-footer ds-print-hidden">
  <div class="inner">
    <p class="provenance">
      <span class="kv"><span class="k">Patch</span> <span class="v">{patch}</span></span>
      {
        sourceWindow && (
          <span class="kv">
            <span class="k">{state === 'live' ? 'Matches played' : 'Window covered'}</span>{' '}
            <span class="v">{windowLabel(sourceWindow.from, sourceWindow.to)}</span>
          </span>
        )
      }
      {
        generatedAt && (
          <span class="kv">
            <span class="k">Compiled</span> <span class="v">{utcStamp(generatedAt)}</span>
          </span>
        )
      }
    </p>

    <nav class="links" aria-label="Site information">
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <p class="riot">
      {TRADEMARK_TEXT} {NON_ENDORSEMENT_TEXT}
    </p>
  </div>
</footer>

<style>
  .ds-footer {
    margin-top: var(--space-8);
    padding: var(--space-5) var(--space-5) var(--space-6);
    color: var(--text-on-dark);
    background-color: var(--primary-color);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--content-max);
    margin: 0 auto;
    font-size: var(--fs-sm);
  }

  .provenance {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
  }

  .k {
    color: var(--text-on-dark-muted);
  }

  .v {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--accent-on-dark);
    font-family: var(--font-mono);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .links a:hover {
    color: var(--text-on-dark);
  }

  .riot {
    max-width: 68ch;
    margin: 0;
    color: var(--text-on-dark-muted);
  }
</style>
