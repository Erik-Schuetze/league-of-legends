---
// The page's own implementation of the frozen `Footer` API. The four links it
// owns - /about, /legal/terms, /legal/privacy and /disclaimer - are the Riot
// compliance surface and are rendered on every page.

import type { Window } from '../../types/agg';
import { utcStamp, windowLabel } from '../../lib/format';
import { NON_ENDORSEMENT_TEXT, TRADEMARK_TEXT } from '../../lib/legal';

interface Props {
  patch: string;
  generatedAt?: string;
  sourceWindow?: Window;
}

const { patch, generatedAt, sourceWindow } = Astro.props;
---

<footer class="fallback-site-footer">
  <p class="fallback-site-footer__provenance">
    Patch {patch}
    {generatedAt && <> &middot; snapshot generated {utcStamp(generatedAt)}</>}
    {sourceWindow && <> &middot; source window {windowLabel(sourceWindow.from, sourceWindow.to)}</>}
  </p>
  <ul class="fallback-site-footer__links">
    <li><a href="/about">About the data</a></li>
    <li><a href="/legal/terms">Terms of Service</a></li>
    <li><a href="/legal/privacy">Privacy Policy</a></li>
    <li><a href="/disclaimer">Disclaimer</a></li>
  </ul>
  <p class="fallback-site-footer__legal">
    {TRADEMARK_TEXT} {NON_ENDORSEMENT_TEXT}
  </p>
</footer>
