{{- /* matchups.tmpl is web/src/layouts/MatchupBody.astro. Markup and whitespace
come from the reference build in web/dist; the transformations that produced this file
asserted every substitution, so a change in the reference build fails loudly instead of
leaving a half-ported page. */ -}}
{{- define "page:matchups" -}}<article><h1>{{ .Label }} matchups{{ if .HasPartition }}, patch {{ .Patch }}{{ end }}</h1><p>{{ .Intro }}</p>{{ if .HasPartition }}<p>Patch <strong>{{ .Patch }}</strong> &middot; {{ .Region }} &middot; queue {{ .Queue }} &middot; bracket {{ .Bracket }} &middot; source window {{ .Window }} &middot; generated {{ .Generated }}</p>{{ end }}{{ if .HasSample }}{{ template "sampleSizeNotice" .Notice }}<p>{{ .Median }}</p>{{ template "heatmapIsland" .Island }}<p>{{ .ColumnNote }}</p><p>Every pair is shown from both sides, so a cell and its mirror are complements of the same games rather than two independent samples: reading the same pair twice does not double the evidence.</p><h2>Champion pages in {{ .LabelLower }}</h2>{{ template "championLinks" .Links }}{{ else }}{{ template "emptyState" .Empty }}{{ end }}<h2>What this table is</h2><p>{{ .Tail }}</p><p><a href="/">All roles</a> &middot; <a href="/tier-list/{{ .Slug }}">{{ .Label }} tier list</a> &middot; <a href="/about">How these numbers are produced</a></p></article>{{- end -}}
