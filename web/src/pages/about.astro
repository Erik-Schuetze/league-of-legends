---
// /about - what this site is, what it is not, and how the numbers are produced.
//
// This is a feature, not boilerplate: it states what is in the snapshot, how
// large the sample is, how the numbers are computed, what the aggregation
// cannot know (the rank-attribution limitation), which of the three data states
// the reader is looking at, and which parts of the design are requirements that
// are not satisfied yet. It reads its facts from the same artifacts the
// statistics pages read, so it cannot describe a snapshot that is not there,
// and it names the pipeline components the same way docs/data-sources.md does.

import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../layouts/JsonLd.astro';
import EmptyState from '../layouts/EmptyState.astro';
import { integer, utcStamp, windowLabel } from '../lib/format';
import { patchLabel, snapshot } from '../lib/page';
import { absoluteUrl, jsonLdWebPage } from '../lib/seo';
import { DEMO_SOURCE, LIVE_SOURCE, PREVIEW_TEXT, UNVERIFIED_PREVIEW_TEXT } from '../lib/site';
import {
  CONTACT_EMAIL,
  CONTACT_ROUTE,
  FREE_TIER_TEXT,
  NO_BROKER_TEXT,
  NO_RATING_TEXT,
  NON_ENDORSEMENT_TEXT,
  NOT_AFFILIATED_TEXT,
  SITE_NAME,
  TRADEMARK_TEXT,
  VERSION_LINE,
  dataSourceSentence,
  ingestedMatchData,
  pipelineLeadIn,
  pipelineStatusSentence,
  riotVerificationNote,
} from '../lib/legal';

const snap = snapshot();
const site = snap.site;
const partition = snap.partition;
const url = absoluteUrl('/about/', Astro.site, Astro.url);

const title = `About the data - how these statistics are produced - ${SITE_NAME}`;

// The meta description is a provenance claim in miniature: it is what a search
// result shows, and it cannot be corrected by a banner the reader has not seen
// yet. So it is written from the state, like everything else on the page.
const description =
  site.state === 'live'
    ? 'Where the numbers on this site come from: Riot MATCH-V5 match records aggregated per patch, the crawl window, ' +
      'the sample-size threshold below which a rate is withheld, the snapshot limitation on rank attribution, and what ' +
      'this site is not.'
    : 'Where the numbers on this site will come from, how they are produced, the sample-size threshold below which a ' +
      'rate is withheld, the snapshot limitation on rank attribution, and what this site is not. This build publishes ' +
      'no Riot match data.';

const stateDescription =
  site.state === 'live'
    ? 'This build rendered a published snapshot of ingested Riot match data.'
    : site.state === 'demo'
      ? site.sourceRecognised
        ? PREVIEW_TEXT
        : UNVERIFIED_PREVIEW_TEXT
      : 'No aggregate snapshot has been published for this site yet.';

const sourceSentence = dataSourceSentence(site);
const hasMatchData = ingestedMatchData(site);

// The name of the API the pipeline fetches from. The demo and no-data states do
// not name it, because naming it beside "how the numbers are produced" reads as
// a statement about where the numbers on this page came from, and in those two
// states they came from nowhere at all.
const matchApi = hasMatchData ? "Riot's MATCH-V5 API" : "Riot's ranked match API";
---

<BaseLayout
  title={title}
  description={description}
  patch={patchLabel(snap)}
  canonical="/about/"
  generatedAt={snap.generatedAt}
  active="/about"
>
  <JsonLd value={jsonLdWebPage(url, title, description)} />

  <article>
    <h1>About this site and its data</h1>

    <p>
      {SITE_NAME} publishes ranked League of Legends statistics as static pages.{' '}
      {site.state === 'live'
        ? "The pages are rendered at build time from aggregate artifacts that a separate ingestion and aggregation pipeline produces from Riot's MATCH-V5 match feed."
        : site.state === 'demo'
          ? 'The pages are rendered at build time from aggregate artifacts, in the same shape a real snapshot has, but these artifacts are illustrative demo data: no ingestion and aggregation pipeline has run for them, and nothing on this build is a measurement of a real game.'
          : 'No aggregate snapshot exists yet, so this build read none and serves the layout of those pages in its empty state: the pages show no numbers from any game, and the aggregate artifacts they will one day be rendered from are the kind an ingestion and aggregation pipeline writes.'}{' '}
      Nothing on this site calls Riot's API while you are reading it, nothing here queries a database, and no page needs
      JavaScript to show its content.
    </p>

    <h2>What this site is</h2>
    <ul>
      <li>
        <strong>A ladder statistics reference.</strong> Win rate, pick rate and ban rate per champion and role, and
        champion-versus-champion matchup rates, for one patch, region, queue and rank bracket at a time.
      </li>
      <li>
        <strong>Static.</strong> Every page is a file that was rendered at build time. There is no request-time
        database, no session, no account and no API call behind a page load.
      </li>
      <li>
        <strong>Honest about its sample.</strong> Every rate is printed next to the number of games it was measured
        over, together with a 95% confidence half-width, and a cell below the publication threshold is withheld rather
        than printed.
      </li>
      <li>
        <strong>Free and ungated.</strong> {FREE_TIER_TEXT}
      </li>
      <li>
        <strong>Readable without JavaScript.</strong> Every route renders its primary content in the served HTML; any
        JavaScript in this site is optional.
      </li>
    </ul>

    <h2>What this site is not</h2>
    <ul>
      <li>
        <strong>Not official, and not endorsed by Riot Games.</strong> {NOT_AFFILIATED_TEXT}
      </li>
      <li>
        <strong>Not a rating service.</strong> {NO_RATING_TEXT}
      </li>
      <li>
        <strong>Not a player lookup, a match-history viewer or a live-game tracker.</strong> There are no player pages
        and no per-player record of any kind in what this site publishes: no account, no summoner name, no PUUID, no
        individual match history.
      </li>
      <li>
        <strong>Not a data broker.</strong> {NO_BROKER_TEXT}
      </li>
      <li>
        <strong>Not commercial.</strong> There is no advertising, no sponsorship, no subscription and no paid tier, and
        the site is not monetised in any way. It is a hobby project run at the operator's own expense.
      </li>
      <li>
        <strong>Not a betting or coaching product.</strong> Nothing here is a prediction, a recommendation or advice;
        see the <a href="/disclaimer">Disclaimer</a>.
      </li>
    </ul>

    <h2>What state this build is in</h2>
    <p>{sourceSentence}</p>
    <p>{stateDescription}</p>

    {
      partition ? (
        <ul>
          <li>
            Patch <strong>{partition.patch}</strong> &middot; region {partition.region} &middot; queue{' '}
            {partition.queue} &middot; rank bracket {partition.bracket}
          </li>
          <li>
            Crawl window: {windowLabel(partition.source_window.from, partition.source_window.to)} (the window of match
            timestamps the aggregation covered, not the time it ran)
          </li>
          <li>Snapshot generated {utcStamp(partition.generated_at)} (the time the aggregate build ran)</li>
          <li>
            Aggregated cells published: {integer(partition.cells_published)} across {integer(partition.champions.length)}
            champions; cells withheld for being below the sample threshold: {integer(partition.suppressed_cells)}
          </li>
          <li>
            Publication threshold: a win, pick or ban rate is published only for a cell holding at least n ={' '}
            {integer(partition.min_cell_n)} games
          </li>
          <li>Build run {integer(partition.build_run_id)} from commit {partition.git_sha.slice(0, 12)}</li>
        </ul>
      ) : (
        <EmptyState
          title="No sample yet"
          body="No aggregate snapshot has been published, so there is no window, no threshold and no cell count to report. The layout, the labels and the sample-size notices are all in place; the numbers appear when the first snapshot is published."
        />
      )
    }

    <p>
      Two compliance requirements are still open rather than met, and this page says so plainly instead of implying
      otherwise. Riot's <em>verified site</em> requirement: {riotVerificationNote()} And the Riot API credential itself:{' '}
      {hasMatchData
        ? "this build rendered a snapshot whose manifest declares it was crawled through Riot's MATCH-V5 API under a " +
          'registered key, so the key is in the ingestion path; the key itself is never part of this build and nothing ' +
          'here carries anything Riot has reviewed or approved.'
        : 'this build was produced without a Riot production API key, so no match data has been ingested or published, ' +
          'and the site carries nothing that Riot has reviewed or approved.'}{' '}
      See <a href="/disclaimer">the Disclaimer</a> for the notices that stay visible until that changes.
    </p>

    <h2>{hasMatchData ? 'How the data is produced' : 'How the data will be produced'}</h2>
    <p>
      {pipelineLeadIn(site)}
    </p>
    <ol>
      <li>
        <strong>Fetch.</strong> A long-running worker (<code>lolstats-ingest</code>) copies match records from {matchApi}{' '}
        at an adaptive rate, and writes each response into an append-only raw archive as compressed Parquet, partitioned
        by API and date (<code>raw/riot/&lt;api&gt;/v&lt;n&gt;/dt=YYYY-MM-DD/</code>). Raw payloads are never rewritten
        in place: if the archive is wrong, the fix is a new partition, not an edit.
      </li>
      <li>
        <strong>Record.</strong> A PostgreSQL control plane tracks the crawl frontier, the fetch queue, deduplication
        keyed by Riot's <code>matchId</code>, and one row per build. It holds crawl state, not visitor state: the
        website never queries it, and it contains no user data of any kind.
      </li>
      <li>
        <strong>Aggregate.</strong> A nightly DuckDB build step reads the raw archive for the target patch window and
        computes counts per cell - patch, region, queue, bracket, champion, role, matchup pair. Cells below the
        publication threshold are suppressed and counted, never rounded up. The build writes
        <code>agg/v1/**</code> plus a manifest that records <code>n</code> for every published cell.
      </li>
      <li>
        <strong>Publish.</strong> The artifact tree is replaced atomically, so a reader sees either the old snapshot or
        the new one and never a half-written tree.
      </li>
      <li>
        <strong>Render.</strong> This site is built from those artifacts, with Riot's Data Dragon static data (names,
        numeric ids, icon paths) fetched at build time by <code>web/scripts/fetch-ddragon.mjs</code> and checked in, so
        that rendering a page needs no network access. The pages and the artifacts are served from the same origin, at
        <code>/</code> and <code>/agg/</code>.
      </li>
    </ol>
    <p>
      {pipelineStatusSentence(site)}
    </p>

    <h2>The sample size story</h2>
    <p>
      Every rate on this site is printed next to the number of games it was measured over, and each rate carries a 95%
      confidence half-width. A 52% win rate over 900 games and a 52% win rate over 90,000 games are not the same claim,
      and the site is built so that you can tell them apart without doing arithmetic.
    </p>
    <p>
      Where a cell is thinner than the publication threshold, this site does not print a rate at all. The cell reads
      "withheld" and shows the count it was withheld for. That is a deliberate refusal: a rate over a few dozen games is
      noise presented as a fact, and rounding it is not publishing it honestly. Cells that the aggregation suppressed
      before publication are counted in the notices on each page rather than silently dropped.
    </p>

    <h2>{hasMatchData ? 'How the numbers are computed' : 'How the numbers will be computed'}</h2>
    <ul>
      <li>
        <strong>Source.</strong>{' '}
        {site.state === 'live'
          ? `Riot's MATCH-V5 match records for ranked solo queue (queue ${partition?.queue ?? 420}), fetched under a registered key and archived append-only before aggregation. Raw archives are never rewritten.`
          : `Nothing yet: ${
              site.state === 'demo'
                ? 'this build holds no match records, so nothing on it is computed from a real game.'
                : 'no snapshot exists, so there are no source records at all.'
            } A real snapshot's source is Riot's ranked match records for ranked solo queue (queue ${
              partition?.queue ?? 420
            }), which the fetch step copies into a raw archive that is never rewritten in place.`}
      </li>
      <li>
        <strong>Grouping.</strong> Matches are grouped by patch, region, queue and rank bracket, then by champion and
        role, then by champion pair for matchups.
      </li>
      <li>
        <strong>Win rate</strong> is wins divided by games played in that champion-and-role cell. Games, not players:
        the same player twice counts twice.
      </li>
      <li>
        <strong>Pick rate</strong> is how often the champion was chosen for the role; <strong>ban rate</strong> is how
        often it was unavailable. Both are shares of the games in the window.
      </li>
      <li>
        <strong>Confidence intervals</strong> are a normal approximation of the binomial interval for the cell's sample,
        reported as a half-width in percentage points. They describe sampling error only; they say nothing about
        selection effects.
      </li>
      <li>
        <strong>Matchup pairs</strong> are stored once per unordered pair. The page shows both directions by taking the
        complement of the stored rate, which is arithmetic rather than a second sample.
      </li>
      <li>
        <strong>Tier letters</strong> are a derived reading aid computed from win rate and pick rate together. They are
        not an official ranking and Riot does not publish one.
      </li>
      <li>
        <strong>Champion identity</strong> comes from Riot's Data Dragon static data, checked into this repository so
        the build works without network access. Icons are loaded from Riot's public Data Dragon CDN by your browser; no
        champion art is hosted, copied or re-encoded here.
      </li>
    </ul>

    <h2>What the aggregation cannot know</h2>
    {!hasMatchData && (
      <p>
        No aggregation has run for this build, so read this section as a limit of the method rather than as a caveat on
        numbers you can see: there are none.
      </p>
    )}
    <p>
      {hasMatchData
        ? "Rank attribution is a snapshot, not a per-match fact. Riot's match feed does not tell an aggregator the rank a player held in each match, so a bracket is built from players discovered at that rank in a recent window."
        : 'Rank attribution can only ever be a snapshot, not a per-match fact. A match record does not carry the rank a player held in that match, so a bracket has to be built from players discovered at that rank in a recent window.'}{' '}
      A match is attributed to the bracket its players were found through, which means the bracket on this page is where
      those accounts were seen, not where every participant was at the time of every game. Treat bracket figures as
      approximate stratification rather than a precise rank filter.
    </p>
    <p>
      Two more limits are worth stating plainly. Aggregates describe the matches in the crawl window, and the ranked
      landscape moves during a patch, so an early-patch reading and a late-patch reading of the same patch are different
      datasets. And because the aggregation only ever sees matches the pipeline was able to fetch, a champion that is
      rare in the crawled population can stay below the publication threshold for a whole patch.
    </p>

    <h2>Source, freshness and provenance of this build</h2>
    <p>
      Freshness here means the crawl window and the patch, not the moment you loaded the page: there is no live data on
      this site. Five values describe any snapshot, and each page prints the ones that apply to the numbers it shows.
    </p>
    <ul>
      <li>
        <strong>Patch</strong> - the game version the matches were played on, because balance changes invalidate a
        reading across a patch boundary.
      </li>
      <li>
        <strong>Region</strong> - the server the matches were played on. Regional metas differ, so rates are not pooled
        across regions.
      </li>
      <li>
        <strong>Queue</strong> - which queue the matches came from.{' '}
        {hasMatchData
          ? 'This site currently aggregates ranked solo/duo (queue 420)'
          : 'The pipeline covers ranked solo/duo (queue 420) and nothing else'}; queue 420 and 440 are different
        populations.
      </li>
      <li>
        <strong>Bracket</strong> - the rank band the cell is drawn from, with the attribution limitation described
        above.
      </li>
      <li>
        <strong>Generated at and source window</strong> - when the aggregate build ran, and which match timestamps it
        covered. A snapshot can be old in either sense, and the two are not the same fact.
      </li>
    </ul>
    <ul>
      <li>Aggregate root read at build time: {site.rootLabel}</li>
      <li>
        Manifest declares its source as{' '}
        <code>{site.source ?? 'nothing: there is no manifest'}</code>
        {site.state === 'live' ? ` (${LIVE_SOURCE}: ingested match data)` : ''}
        {site.state === 'demo'
          ? site.sourceRecognised
            ? ` (${DEMO_SOURCE}: illustrative fixtures, not match statistics)`
            : ' (unrecognised, so this build treats the numbers as unverified)'
          : ''}
      </li>
      <li>
        Patches in this build: {snap.patches.length > 0 ? snap.patches.join(', ') : 'none published'}
      </li>
      <li>
        Every page states whether it is real, preview or empty in a banner at the top, and the state is decided from the
        manifest alone rather than from a build flag a later change could forget to set.
      </li>
    </ul>

    <h2>Attribution and notices</h2>
    <p>{TRADEMARK_TEXT}</p>
    <p>{NON_ENDORSEMENT_TEXT}</p>
    <p>
      {NO_RATING_TEXT} No personal data is sold, brokered or shared, and the pages you are reading were produced from
      aggregate counts: they contain no per-player record, name, account or match history.
    </p>
    <p>
      Champion icons and item, rune and spell icons are requested by your browser directly from Riot's Data Dragon CDN.
      They are never vendored into this repository, re-encoded or re-served, and that CDN sees your IP address the same
      way any other image host would. See the <a href="/legal/privacy">Privacy Policy</a> for what your browser talks
      to and what this site's own logs contain.
    </p>
    <p>
      The text is set in Inter, JetBrains Mono and Montserrat. All three are self-hosted from <code>/fonts/</code> under
      the SIL Open Font License 1.1, and no font request leaves this deployment: the licence notices ship next to the
      files as <a href="/fonts/OFL-Inter.txt">OFL-Inter.txt</a>,
      <a href="/fonts/OFL-JetBrainsMono.txt">OFL-JetBrainsMono.txt</a> and
      <a href="/fonts/OFL-Montserrat.txt">OFL-Montserrat.txt</a>.
    </p>
    <p>{CONTACT_ROUTE}</p>
    <p>
      Corrections are welcome and are treated as faults: if a number here is wrong, the honest outcome is a corrected
      snapshot with a new build record, not a quiet edit. Write to <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
    </p>
    <p>
      <small>{VERSION_LINE}</small>
    </p>

    <h2>Rules and policies</h2>
    <ul>
      <li><a href="/legal/terms">Terms of Service</a></li>
      <li><a href="/legal/privacy">Privacy Policy</a> - this site serves static content and sets no tracking cookies</li>
      <li><a href="/disclaimer">Disclaimer</a> - Riot's non-endorsement notice and the limits of these numbers</li>
    </ul>
    {
      !hasMatchData && (
        <p>
          <strong>No match data has been ingested yet</strong>, so nothing on this site is a measurement of real games.
          That is the state of the project, not a fault in the pages: the layout, the labels and the sample-size
          notices are finished and waiting for the first snapshot.
        </p>
      )
    }
  </article>
</BaseLayout>
