{{ define "nojsBar" }}<form class="ds-filter-bar ds-print-hidden" action="{{ .Action }}" method="get" aria-label="Filters" data-astro-cid-2t5tmnod>{{ range .Hidden }}<input type="hidden" name="{{ .Name }}" value="{{ .Value }}" data-astro-cid-2t5tmnod>{{ end }}<div class="fields" data-astro-cid-2t5tmnod>{{ range .Fields }}<p class="field" data-astro-cid-2t5tmnod><label for="filter-{{ .Name }}" data-astro-cid-2t5tmnod>{{ .Label }}</label>{{ if eq .Kind "select" }}<select id="filter-{{ .Name }}" name="{{ .Name }}" data-astro-cid-2t5tmnod>{{ range .Options }}<option value="{{ .Value }}"{{ if .Selected }} selected{{ end }} data-astro-cid-2t5tmnod>{{ .Label }}</option>{{ end }}</select>{{ else }}<input id="filter-{{ .Name }}" type="search" name="{{ .Name }}" value="{{ .Value }}" autocomplete="off" maxlength="{{ .MaxLen }}" data-astro-cid-2t5tmnod>{{ end }}</p>{{ end }}</div><button type="submit" class="submit" data-astro-cid-2t5tmnod>Apply</button>{{ if .HasClear }}<a class="clear" href="{{ .Clear }}" data-astro-cid-2t5tmnod>Clear</a>{{ end }}</form>{{ end }}
{{ define "nojsPager" }}<nav class="pager ds-print-hidden" aria-label="Pages" data-astro-cid-2t5tmnod>{{ if .HasPrev }}<a rel="prev" href="{{ .Prev }}" data-astro-cid-2t5tmnod>Previous</a>{{ else }}<span class="pager__off" data-astro-cid-2t5tmnod>Previous</span>{{ end }}<span class="pager__label" data-astro-cid-2t5tmnod>{{ .Label }}</span>{{ if .HasNext }}<a rel="next" href="{{ .Next }}" data-astro-cid-2t5tmnod>Next</a>{{ else }}<span class="pager__off" data-astro-cid-2t5tmnod>Next</span>{{ end }}</nav>{{ end }}
