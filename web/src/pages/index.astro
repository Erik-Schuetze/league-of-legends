---
// The home page: what this site is, what state its data is in, and where to go.
//
// Its job in the deployed 'no data' state is to read as a product that has not
// published its first snapshot yet, with an honest description of what will be
// published, rather than as a failed build.

import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../layouts/EmptyState.astro';
import JsonLd from '../layouts/JsonLd.astro';
import { ROLES, roleLabel, roleSlug } from '../lib/roles';
import { emptyReason, patchLabel, snapshot } from '../lib/page';
import { integer, utcStamp, windowLabel } from '../lib/format';
import { jsonLdWebsite } from '../lib/seo';

const snap = snapshot();
const { site, partition } = snap;

// The homepage is the page a search engine and a first-time reader meet first, so its
// title and description are written from the data state as well: "statistics from Riot
// match data" is a provenance claim, and this build may only make it when the manifest
// declares that is what the snapshot is.
const live = site.state === 'live';

const title = live
  ? 'LoL Stats - League of Legends ranked statistics from Riot match data'
  : 'LoL Stats - League of Legends ranked statistics';

const description = live
  ? 'Patch-specific League of Legends ranked tier lists and champion matchups, computed from Riot match data. ' +
    'Every win rate carries its sample size, and thin samples are withheld rather than shown.'
  : site.state === 'demo'
    ? 'What this site publishes, how the numbers are produced, and an honest statement of where the numbers on ' +
      'this build come from: it is a labelled preview, not measured Riot match data.'
    : 'What this site publishes and how the numbers will be produced once a snapshot exists. No aggregate ' +
      'snapshot has been published yet, so this build carries no match statistics at all.';

const url = new URL('/', Astro.site ?? Astro.url).href;
const roles = [...ROLES];
const minCellN = partition?.min_cell_n ?? null;
---

<BaseLayout
  title={title}
  description={description}
  patch={patchLabel(snap)}
  canonical="/"
  generatedAt={snap.generatedAt}
  active="/"
>
  <JsonLd value={jsonLdWebsite(site, url, description)} />

  <h1>Ranked statistics, every rate with its sample size</h1>

  <p>
    {live
      ? 'This site aggregates League of Legends ranked matches into per-patch tier lists and champion matchup tables.'
      : 'This site publishes per-patch tier lists and champion matchup tables.'}{' '}
    There is no client-side data fetching and no JavaScript is required to read any page: what the HTML says is the whole
    product.{' '}
    {site.state === 'demo'
      ? 'This build is a labelled preview: the numbers on it are illustrative, and no Riot match data has been ingested.'
      : site.state === 'no-data'
        ? 'No aggregate snapshot has been published yet, so this build carries no match statistics at all.'
        : ''}
  </p>

  <h2>Current snapshot</h2>
  {
    partition ? (
      <ul>
        <li>
          Patch <strong>{partition.patch}</strong> &middot; {partition.region} &middot; queue {partition.queue} &middot;
          bracket {partition.bracket}
        </li>
        <li>Source window {windowLabel(partition.source_window.from, partition.source_window.to)}</li>
        <li>Snapshot generated {utcStamp(partition.generated_at)}</li>
        <li>
          {integer(partition.cells_published)} published cells over {integer(partition.champions.length)} champions;
          rates published from n = {integer(partition.min_cell_n)} games
        </li>
        <li>
          {integer(partition.suppressed_cells)} cells withheld for being below that threshold, and shown as withheld
          wherever they appear
        </li>
      </ul>
    ) : (
      <EmptyState title="No sample yet" body={emptyReason(snap)} />
    )
  }

  <h2>Tier lists by role</h2>
  <ul>
    {
      roles.map((role) => (
        <li>
          <a href={`/tier-list/${roleSlug(role)}`}>{roleLabel(role)} tier list</a> &middot;{' '}
          <a href={`/matchups/${roleSlug(role)}`}>{roleLabel(role)} matchups</a>
        </li>
      ))
    }
  </ul>

  <h2>{live ? 'How to read these numbers' : 'How these numbers will be read'}</h2>
  {
    !live && (
      <p>
        {site.state === 'demo'
          ? 'The conventions below are the ones this build already renders, but the sample sizes and rates behind them are illustrative demo values rather than measured games.'
          : 'This build publishes no sample sizes and no rates yet; the conventions below are the ones every page is laid out for.'}
      </p>
    )
  }
  <ul>
    <li>Every win, pick and ban rate is shown with the number of games it was measured over.</li>
    <li>
      A rate is published only where the cell holds at least n = {minCellN === null ? 'the publication threshold' : integer(minCellN)} games;
      thinner cells are shown as withheld, with their count and no rate.
    </li>
    <li>
      Each rate carries a 95% interval, because 52% over 900 games and 52% over 90,000 games are not the same claim.
    </li>
    <li>
      {live
        ? "Rank data comes from Riot's match feed, which does not attribute a match to the player's exact rank, so bracket figures are a snapshot attribution rather than a per-match one."
        : "Riot does not attribute a match to the player's exact rank, so on a published snapshot the bracket figures are a snapshot attribution rather than a per-match one."}
    </li>
  </ul>
  <p><a href="/about">How these numbers are produced</a></p>

  <h2>Champions</h2>
  <p>
    {integer(site.champions.length)} champions are known to this build from Data Dragon {site.ddragonVersion}. Each has a
    page for every role it has been played in this snapshot.
  </p>
  <ul class="fallback-champion-links">
    {
      site.champions.map((champion) => (
        <li>
          <a href={`/champions/${champion.slug}`}>{champion.name}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>
