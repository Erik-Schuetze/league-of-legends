{{- /* shell.tmpl is a transcription of web/src/layouts/BaseLayout.astro, web/src/layouts/StateBanner.astro,
       web/src/components/Nav.astro and web/src/components/Footer.astro as the reference build emits them.

       Whitespace here is output, not layout: the published build writes the markup with no whitespace between
       tags, so this file must too. Keep it on one line. The data-astro-cid-* attributes are the scoped-style
       suffixes of the design system that was kept as-is, and they are load-bearing for the two inline <style>
       chunks the embed carries. */ -}}
{{- define "shell" -}}<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ .Title }}</title><meta name="description" content="{{ .Description }}"><link rel="canonical" href="{{ .Canonical }}"><meta name="robots" content="{{ .Robots }}"><meta property="og:type" content="website"><meta property="og:site_name" content="LoL Stats"><meta property="og:title" content="{{ .Title }}"><meta property="og:description" content="{{ .Description }}"><meta property="og:url" content="{{ .Canonical }}"><meta property="og:locale" content="en_US"><meta name="twitter:card" content="summary"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="sitemap" type="application/xml" href="/sitemap.xml"><link rel="preload" as="font" type="font/woff2" href="/fonts/inter-400.woff2" crossorigin><link rel="preload" as="font" type="font/woff2" href="/fonts/inter-600.woff2" crossorigin><link rel="stylesheet" href="{{ .Stylesheet }}"><style>{{ .ScopedCSS }}</style></head><body data-state="{{ .State }}" data-source="{{ .Source }}"><a class="fallback-skip" href="#main">Skip to content</a><aside class="state-banner {{ .Banner.Class }}" data-state="{{ .State }}" role="note" aria-label="Data provenance" style="{{ .Banner.Style }}"><p class="state-banner__heading"><strong>{{ .Banner.Heading }}</strong></p><p class="state-banner__body">{{ .Banner.Body }}</p><p class="state-banner__link"><a href="{{ .Banner.LinkHref }}">{{ .Banner.LinkText }}</a></p></aside><header class="ds-navbar ds-print-hidden" data-astro-cid-wpvy4v7s><nav class="bar" aria-label="Site" data-astro-cid-wpvy4v7s><a class="brand" href="/" data-astro-cid-wpvy4v7s>lolstats</a><ul class="roles" data-astro-cid-wpvy4v7s>{{ range .Nav.TierLinks }}<li data-astro-cid-wpvy4v7s><a class="link" href="{{ .Href }}" {{ if .Current }}aria-current="page" {{ end }}data-astro-cid-wpvy4v7s>{{ .Label }}</a></li>{{ end }}</ul><details class="menu" data-astro-cid-wpvy4v7s><summary class="summary" data-astro-cid-wpvy4v7s>Matchups</summary><ul class="panel" data-astro-cid-wpvy4v7s>{{ range .Nav.MatchupLinks }}<li data-astro-cid-wpvy4v7s><a class="link" href="{{ .Href }}" {{ if .Current }}aria-current="page" {{ end }}data-astro-cid-wpvy4v7s>{{ .Label }}</a></li>{{ end }}</ul></details><p class="patch" data-astro-cid-wpvy4v7s><span class="ds-visually-hidden" data-astro-cid-wpvy4v7s>Patch </span>{{ .Nav.Patch }}</p></nav></header><main id="main">{{ if .JSONLD }}<script type="application/ld+json">{{ .JSONLD }}</script>{{ end }}{{ .Body }}</main><footer class="ds-footer ds-print-hidden" data-astro-cid-jo6i4kqk><div class="inner" data-astro-cid-jo6i4kqk><p class="provenance" data-astro-cid-jo6i4kqk>{{ range .Footer.Items }}<span class="kv" data-astro-cid-jo6i4kqk><span class="k" data-astro-cid-jo6i4kqk>{{ .Key }}</span> <span class="v" data-astro-cid-jo6i4kqk>{{ .Value }}</span></span>{{ end }}</p><nav class="links" aria-label="Site information" data-astro-cid-jo6i4kqk><ul data-astro-cid-jo6i4kqk>{{ range .Footer.Links }}<li data-astro-cid-jo6i4kqk><a href="{{ .Href }}" data-astro-cid-jo6i4kqk>{{ .Label }}</a></li>{{ end }}</ul></nav><p class="riot" data-astro-cid-jo6i4kqk>{{ .Footer.Riot }}</p></div></footer></body></html>{{- end -}}
