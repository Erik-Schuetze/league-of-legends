---
// /patch/<version>/tier-list/<role> - one published snapshot, addressed by patch.
//
// One page is generated per published patch, so the patch switcher on every
// tier list is a set of plain links between static files: changing patches is a
// navigation, and it works with JavaScript disabled.

import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TierListBody from '../../../../layouts/TierListBody.astro';
import type { Role } from '../../../../types/agg';
import { ROLES, roleLabel, roleSlug } from '../../../../lib/roles';
import { snapshot, tierListFor } from '../../../../lib/page';
import { absoluteUrl } from '../../../../lib/seo';

// One page per published patch and role. With no published snapshot there is no
// patch to archive, so this route has no pages rather than a placeholder for a
// patch that was never ingested.
export function getStaticPaths() {
  return snapshot().patches.flatMap((version) =>
    ROLES.map((role) => ({ params: { version, role: roleSlug(role) }, props: { role, version } })),
  );
}

const versions = snapshot().patches;

interface Props {
  role: Role;
  version: string;
}

const { role, version } = Astro.props;
const label = roleLabel(role);
const slug = roleSlug(role);

const snap = snapshot(version);
const tierList = tierListFor(snap);
const url = absoluteUrl(`/patch/${version}/tier-list/${slug}/`, Astro.site, Astro.url);

const partition = snap.partition;
const title = `${label} tier list, patch ${version} - League of Legends - LoL Stats`;
const description = partition
  ? `${label} champion win, pick and ban rates for League of Legends patch ${version}, ` +
    `${partition.region} ranked solo queue, measured over ${partition.source_window.from.slice(0, 10)} to ` +
    `${partition.source_window.to.slice(0, 10)}, each rate with its sample size.`
  : `The archived ${label.toLowerCase()} tier list for patch ${version}. This patch has no published snapshot.`;
---

<BaseLayout
  title={title}
  description={description}
  patch={version}
  canonical={`/patch/${version}/tier-list/${slug}/`}
  generatedAt={snap.generatedAt}
  active={`/patch/${version}/tier-list/${slug}`}
>
  <TierListBody snap={snap} role={role} tierList={tierList} url={url} />
  <p>
    <a href={`/tier-list/${slug}`}>Newest patch {label.toLowerCase()} tier list</a> ({versions.length} patch
    {versions.length === 1 ? '' : 'es'} published: {versions.join(', ')})
  </p>
</BaseLayout>
