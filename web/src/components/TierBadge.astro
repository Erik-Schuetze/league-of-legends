---
import type { Tier } from '../types/agg';
import { integer } from '../lib/format';

interface Props {
  tier: Tier;
  n?: number;
}

const { tier, n } = Astro.props;

// One class per grade. The grade names the token family; it is not a colour
// name, so re-theming only touches tokens.css and global.css.
const grade = tier === 'S+' ? 'splus' : tier.toLowerCase();
---

<span class="tier">
  <span class={`badge grade-${grade}`} data-tier={tier}><span class="ds-visually-hidden">Tier </span>{tier}</span>
  {n !== undefined && <span class="n">n {integer(n)}</span>}
</span>

<style>
  .tier {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    white-space: nowrap;
  }

  .badge {
    display: inline-block;
    min-width: 1.9em;
    padding: 0 0.25em;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
    color: var(--tier-ink);
    border: var(--border-width) solid var(--tier-ink);
  }

  /* Six steps of one hue. The letter carries the grade; the fill only orders
     it, so the ramp survives greyscale, colour blindness and print. */
  .grade-splus {
    background-color: var(--tier-splus-bg);
  }

  .grade-s {
    background-color: var(--tier-s-bg);
  }

  .grade-a {
    background-color: var(--tier-a-bg);
  }

  .grade-b {
    background-color: var(--tier-b-bg);
  }

  .grade-c {
    background-color: var(--tier-c-bg);
  }

  .grade-d {
    background-color: var(--tier-d-bg);
  }

  .n {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  @media print {
    .badge {
      background-color: transparent !important;
      color: var(--print-ink);
      border-color: var(--print-ink);
    }
  }
</style>
