---
// The page's own implementation of the frozen `TierBadge` API. The tier letter
// is always shown; the sample size is carried in the title so a reader who
// wants it does not have to leave the cell.

import type { Tier } from '../../types/agg';
import { integer } from '../../lib/format';

interface Props {
  tier: Tier;
  n?: number;
}

const { tier, n } = Astro.props;
const modifier = tier.toLowerCase().replace('+', '-plus');
---

<span
  class:list={['fallback-tier-badge', `fallback-tier-badge--${modifier}`]}
  title={n === undefined ? `Tier ${tier}` : `Tier ${tier}, n = ${integer(n)} games`}
>{tier}</span>
