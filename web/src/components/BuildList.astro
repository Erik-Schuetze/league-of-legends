---
import type { Build } from '../types/agg';
import StatValue from './StatValue.astro';

// Agreed by shape with the pages that pass it, not by import: the frontend
// workstream builds this object from web/src/data/{items,runes,spells}.json and
// this component never learns where it came from. See ADR-006.
export interface BuildLookupEntry {
  /** Display name, used as the icon's alt text. */
  name: string;
  /** Data Dragon CDN path, used verbatim as the img src. */
  icon: string;
}

export interface BuildLookup {
  ddragonVersion: string;
  items: Record<number, BuildLookupEntry>;
  runes: Record<number, BuildLookupEntry>;
  spells: Record<number, BuildLookupEntry>;
}

interface Props {
  title: string;
  builds: Build[];
  kind: 'items' | 'runes' | 'spells';
  limit?: number;
  emptyMessage?: string;
  lookup?: BuildLookup;
}

const { title, builds, kind, limit = 10, emptyMessage = 'No data for this selection.', lookup } = Astro.props;

// The aggregator already sorted by n descending; the component renders the
// order it was given and only ever truncates.
const shown = builds.slice(0, limit);

const kindLabel = kind === 'items' ? 'Item' : kind === 'runes' ? 'Rune' : 'Summoner spell';

// Keys that the lookup cannot resolve stay numeric chips. The lookup is per key,
// not per list, so a build whose items are partly unknown still renders - the
// component degrades, it does not fail.
const entries = lookup ? lookup[kind] : undefined;
const entryFor = (id: number) => entries?.[id];
---

<section class="ds-build-list">
  <h3 class="title">{title}</h3>

  {
    shown.length === 0 ? (
      <p class="empty">{emptyMessage}</p>
    ) : (
      <ol class="rows" role="list">
        {shown.map((build) => (
          <li class="row">
            {/* With a lookup each key is its game-data icon and carries the name
                as alt text, so the cell is announced and not hidden; the numeric
                key list is dropped because the names now say the same thing.
                Without a lookup the keys are not buildable into image paths, so
                the frozen numeric chips render instead. */}
            <span class="key" aria-hidden={entries ? undefined : 'true'}>
              {build.key.map((id) => {
                const entry = entryFor(id);
                return entry ? (
                  <img class="icon" src={entry.icon} alt={entry.name} width="24" height="24" loading="lazy" />
                ) : (
                  <span class="chip">{id}</span>
                );
              })}
            </span>
            {!entries && (
              <span class="ds-visually-hidden">
                {kindLabel} key: {build.key.join(', ')}
              </span>
            )}

            <span class="label">{build.label}</span>

            <span class="stats">
              <StatValue value={build.n} format="integer" label="matches" />
              <StatValue value={build.win_rate} format="percent" label="win" />
            </span>
          </li>
        ))}
      </ol>
    )
  }
</section>

<style>
  .ds-build-list {
    margin: 0 0 var(--space-5);
  }

  .title {
    margin: 0 0 var(--space-2);
    font-size: var(--fs-lg);
  }

  .empty {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    background-color: var(--bg-light);
  }

  .rows {
    counter-reset: rank;
    display: flex;
    flex-direction: column;
    /* Tight list rhythm: the generous page scale stops at the section heading. */
    gap: var(--list-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 2.25rem auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--row-pad-y) var(--row-pad-x);
    background-color: var(--bg-light);
    border-bottom: var(--border-width) solid var(--hairline);
  }

  .row::before {
    counter-increment: rank;
    content: counter(rank);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-align: right;
  }

  .key {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
  }

  .chip {
    min-width: 2.4em;
    padding: 0 0.25em;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    text-align: center;
    color: var(--primary-color);
    background-color: var(--bg-color);
    border: 1px solid var(--hairline);
  }

  /* The site's edge treatment on a game-data icon: the same structure rule the
     frames use, so an icon reads as a drawn object and not as a floating
     bitmap. The box is square, which keeps the row's height stable while images
     load, and the light field shows through a transparent PNG. */
  .icon {
    display: block;
    width: 24px;
    height: 24px;
    object-fit: contain;
    background-color: var(--bg-color);
    border: var(--border-width) solid var(--primary-color);
  }

  .label {
    min-width: 0;
    overflow-wrap: anywhere;
    font-size: var(--fs-sm);
  }

  .stats {
    display: flex;
    gap: var(--space-3);
  }

  @media (max-width: 40rem) {
    .row {
      grid-template-columns: 2rem minmax(0, 1fr);
    }

    .key,
    .stats {
      grid-column: 2;
    }
  }
</style>
