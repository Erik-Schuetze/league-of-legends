---
// JSON-LD emitted from the page's own values. `is:inline` keeps Astro from
// bundling it as a module: it is data for a crawler, not script for the page,
// and nothing about the rendered content depends on it.

import { jsonLdScript, type JsonLd } from '../lib/seo';

interface Props {
  value: JsonLd | JsonLd[];
}

const { value } = Astro.props;
---

<script type="application/ld+json" is:inline set:html={jsonLdScript(Array.isArray(value) ? value : [value])} />
