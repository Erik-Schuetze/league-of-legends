---
import type { Window } from '../types/agg';
import { utcStamp, windowLabel } from '../lib/format';

interface Props {
  patch: string;
  generatedAt?: string;
  sourceWindow?: Window;
}

const { patch, generatedAt, sourceWindow } = Astro.props;

// The four compliance links. They are part of the Riot compliance surface, so
// they are rendered unconditionally and no page can drop them.
const links = [
  { href: '/about', label: 'About' },
  { href: '/legal/terms', label: 'Terms' },
  { href: '/legal/privacy', label: 'Privacy' },
  { href: '/disclaimer', label: 'Disclaimer' },
];
---

<footer class="ds-footer ds-print-hidden">
  <div class="inner">
    <p class="provenance">
      <span class="kv"><span class="k">Patch</span> <span class="v">{patch}</span></span>
      {
        sourceWindow && (
          <span class="kv">
            <span class="k">Matches played</span>{' '}
            <span class="v">{windowLabel(sourceWindow.from, sourceWindow.to)}</span>
          </span>
        )
      }
      {
        generatedAt && (
          <span class="kv">
            <span class="k">Compiled</span> <span class="v">{utcStamp(generatedAt)}</span>
          </span>
        )
      }
    </p>

    <nav class="links" aria-label="Site information">
      <ul>
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>

    <p class="riot">
      A statistics mirror of ranked solo queue. Not endorsed by Riot Games, and it
      does not reflect the views of Riot Games or anyone involved in producing or
      managing Riot Games properties. League of Legends and Riot Games are
      trademarks or registered trademarks of Riot Games, Inc.
    </p>
  </div>
</footer>

<style>
  .ds-footer {
    margin-top: var(--space-8);
    padding: var(--space-5) var(--space-5) var(--space-6);
    color: var(--text-on-dark);
    background-color: var(--primary-color);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: var(--content-max);
    margin: 0 auto;
    font-size: var(--fs-sm);
  }

  .provenance {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
  }

  .k {
    color: var(--text-on-dark-muted);
  }

  .v {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--accent-on-dark);
    font-family: var(--font-mono);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .links a:hover {
    color: var(--text-on-dark);
  }

  .riot {
    max-width: 68ch;
    margin: 0;
    color: var(--text-on-dark-muted);
  }
</style>
