---
// The banner that tells the reader which of the three data states this page is
// in. It is rendered by BaseLayout on every route, from the manifest alone, and
// it is the reason a preview snapshot cannot be mistaken for real statistics.
//
// The styling is inline and deliberately not token-based: this is the one
// element whose visibility is a correctness requirement, so it must be
// unmissable even if a stylesheet is missing or fails to load. Every other
// surface is styled by the design system.

import type { Window } from '../types/agg';
import { integer, utcStamp, windowLabel } from '../lib/format';
import type { StateBanner as StateBannerData } from '../lib/site';

interface Props {
  banner: StateBannerData;
  patch: string;
  generatedAt?: string;
  sourceWindow?: Window;
  minCellN?: number | null;
  suppressedCells?: number | null;
}

const { banner, patch, generatedAt, sourceWindow, minCellN, suppressedCells } = Astro.props;
const warning = 'background:#111111;color:#ffffff;border:4px solid #ffd400;padding:0.9rem 1rem;';
const calm = 'background:#f4f4f4;color:#111111;border:4px solid #111111;padding:0.9rem 1rem;';
---

{
  banner.state === 'live' ? (
    <aside class="state-banner state-banner--live" data-state="live" role="note" aria-label="Data provenance" style={calm}>
      <p class="state-banner__heading">
        <strong>Published snapshot</strong>
      </p>
      <p class="state-banner__body">
        Patch {patch}
        {generatedAt && <> &middot; generated {utcStamp(generatedAt)}</>}
        {sourceWindow && <> &middot; source window {windowLabel(sourceWindow.from, sourceWindow.to)}</>}
        {minCellN !== null && minCellN !== undefined && <> &middot; cells published from n = {integer(minCellN)} games</>}
        {suppressedCells !== null && suppressedCells !== undefined && suppressedCells > 0 && (
          <> &middot; {integer(suppressedCells)} cells withheld as too thin</>
        )}
        . Read by machine from the published aggregate artifacts; no client-side fetching is involved.
      </p>
      <p class="state-banner__link"><a href={banner.href}>How these numbers are produced</a></p>
    </aside>
  ) : (
    <aside
      class:list={['state-banner', `state-banner--${banner.state}`]}
      data-state={banner.state}
      role="note"
      aria-label="Data provenance"
      style={warning}
    >
      <p class="state-banner__heading">
        <strong>{banner.heading}</strong>
      </p>
      <p class="state-banner__body">{banner.body}</p>
      {banner.state === 'no-data' ? (
        <p class="state-banner__link"><a href={banner.href}>What will be published here</a></p>
      ) : (
        <p class="state-banner__link"><a href={banner.href}>What this preview is and is not</a></p>
      )}
    </aside>
  )
}
