---
// The body of a matchup page, shared by /matchups/<role> and by the matchup
// section of a champion's role page.
//
// The artifact stores each unordered pair once, so the matrix is built by
// reading the stored pair and, where the pair is stored the other way round,
// reporting the complement of the stored win rate. That is arithmetic, not an
// estimate. Cells the aggregator withheld are rendered as withheld, never as
// zero and never as a rate.

import EmptyState from './EmptyState.astro';
import FallbackDataTable from './fallback/DataTable.astro';
import JsonLd from './JsonLd.astro';
import SampleSizeNotice from './fallback/SampleSizeNotice.astro';
import type { Matchups, Role } from '../types/agg';
import { integer, median, utcStamp, windowLabel } from '../lib/format';
import { cellAvailability } from '../lib/artifacts';
import { componentOr, optionalComponent } from '../lib/components';
import { roleLabel, roleSlug } from '../lib/roles';
import { NO_SAMPLE, WITHHELD, columnAvailabilityNote, matchupMatrix, type Column, type Row } from '../lib/rows';
import { emptyReason, type Snapshot } from '../lib/page';
import { previewNumbersSentence } from '../lib/legal';
import { jsonLdDataset } from '../lib/seo';

interface Props {
  snap: Snapshot;
  role: Role;
  matchups: Matchups | null;
  url: string;
}

const { snap, role, matchups, url } = Astro.props;
const slug = roleSlug(role);
const label = roleLabel(role);
const partition = snap.partition;
const minCellN = matchups?.min_cell_n ?? partition?.min_cell_n ?? 0;
const suppressedCells = matchups?.suppressed_cells ?? partition?.suppressed_cells ?? null;

// docs/contracts.md section 3 gives HeatmapIsland to this route. Both it and the
// fallback render a complete server-side table, so neither requires JavaScript.
const HeatmapIsland = await optionalComponent('HeatmapIsland');
const DataTable = await componentOr('DataTable', FallbackDataTable);

const matrix = matchups ? matchupMatrix(matchups, snap.site, minCellN) : null;
const matrixChampions = matrix?.champions ?? [];

const publishedPairs = (matchups?.cells ?? []).filter((cell) => cellAvailability(cell, minCellN) === 'published');
const pairCounts = publishedPairs.map((cell) => cell.n).sort((a, b) => a - b);
// The median pair, used as the page's sample-size notice. A total across the
// matrix would count the same match once per pair it contains, so a total would
// be a bigger number that means less.
const medianPairN = median(pairCounts);
const smallestPairN = pairCounts.length > 0 ? pairCounts[0] : 0;
const largestPairN = pairCounts.length > 0 ? pairCounts[pairCounts.length - 1] : 0;

const columns: Column[] = matrix
  ? [{ key: 'champion', label: 'Champion' }, ...matrixChampions.map((champion) => ({ key: `o${champion.id}`, label: champion.name }))]
  : [];
const rows: Row[] =
  matrix === null
    ? []
    : matrixChampions.map((rowChampion) => {
        const row: Row = { champion: rowChampion.name };
        for (const columnChampion of matrixChampions) {
          const key = `o${columnChampion.id}`;
          if (columnChampion.id === rowChampion.id) {
            row[key] = null;
            continue;
          }
          const cell = matrix.get(rowChampion.id, columnChampion.id);
          if (!cell) {
            row[key] = NO_SAMPLE;
            continue;
          }
          row[key] =
            cell.availability === 'published' ? cell.winRate : cell.availability === 'withheld' ? WITHHELD : NO_SAMPLE;
        }
        return row;
      });

const hasSample = matchups !== null && publishedPairs.length > 0;
// Empty on a live snapshot, so the live page reads exactly as it did before.
const preview = previewNumbersSentence(snap.site);
---

<article>
  <h1>{label} matchups{partition ? `, patch ${partition.patch}` : ''}</h1>
  <p>
    {
      partition
        ? `Champion against champion in ${label.toLowerCase()}, as the win rate of the row champion in the pair. Each pair is measured over the source window below and only over matches in ranked solo queue.${
            preview ? ` ${preview}` : ''
          }`
        : `This table will show champion against champion matchups in ${label.toLowerCase()} as soon as a snapshot is published.`
    }
  </p>

  {
    partition ? (
      <p>
        Patch <strong>{partition.patch}</strong> &middot; {partition.region} &middot; queue {partition.queue} &middot;
        bracket {partition.bracket} &middot; source window{' '}
        {windowLabel(partition.source_window.from, partition.source_window.to)} &middot; generated{' '}
        {utcStamp(partition.generated_at)}
      </p>
    ) : null
  }

  {
    hasSample && matchups ? (
      <>
        <SampleSizeNotice n={medianPairN} minCellN={minCellN} suppressedCells={suppressedCells} role={role} />
        <p>
          n above is the median number of games behind a champion pair on this page, not a total: a match contains many
          pairs, so a matrix-wide total would count the same game once per pair it contains and would mean less than the
          pair sample does. Pair samples here run from n = {integer(smallestPairN)} to n = {integer(largestPairN)} games
          over {integer(publishedPairs.length)} published pairs.
        </p>
        {HeatmapIsland ? (
          <HeatmapIsland
            matchups={matchups}
            champions={matrixChampions}
            role={role}
            minCellN={minCellN}
          />
        ) : (
          <DataTable
            columns={columns}
            rows={rows}
            caption={`${label} champion matchups, patch ${partition?.patch}`}
            initialSortKey="champion"
            initialSortDir="asc"
          />
        )}
        <p>{columnAvailabilityNote(minCellN, suppressedCells)}</p>
        <p>
          Every pair is shown from both sides, so a cell and its mirror are complements of the same games rather than two
          independent samples: reading the same pair twice does not double the evidence.
        </p>

        <h2>Champion pages in {label.toLowerCase()}</h2>
        <ul class="fallback-champion-links">
          {
            matrixChampions.map((champion) => (
              <li>
                <a href={`/champions/${champion.slug}/${slug}`}>
                  {champion.name} {label.toLowerCase()} matchups
                </a>
              </li>
            ))
          }
        </ul>
      </>
    ) : (
      <EmptyState
        title={partition ? `No ${label.toLowerCase()} matchup cells published` : 'No sample yet'}
        body={
          partition
            ? `The snapshot for patch ${partition.patch} has no matchup artifact for this role, so no pair is shown rather than an estimate.`
            : emptyReason(snap)
        }
        minCellN={partition?.min_cell_n ?? null}
      />
    )
  }

  <h2>What this table is</h2>
  <p>
    A cell holds the win rate of the row champion against the column champion, with the number of games it was measured
    over. Cells whose pair has fewer than n = {integer(minCellN)} games read "{WITHHELD}" and show their count only; that
    is a pair this site declines to publish a rate for, not a pair that does not exist.{preview ? ` ${preview}` : ''}
  </p>

  {
    matchups && partition && snap.site.state === 'live' ? (
      <JsonLd
        value={jsonLdDataset({
          url,
          name: `${label} champion matchups, League of Legends patch ${partition.patch}`,
          description:
            `Champion-versus-champion win rates for ${label.toLowerCase()} in ${partition.region} ranked solo queue, ` +
            `patch ${partition.patch}, measured over ${windowLabel(partition.source_window.from, partition.source_window.to)}.`,
          patch: partition.patch,
          sourceWindow: partition.source_window,
          generatedAt: partition.generated_at,
          minCellN,
          sampleSize: medianPairN,
          variables: [
            { name: 'games played in the pair (n)', unit: 'games' },
            { name: 'pair win rate', unit: 'win rate' },
          ],
          state: snap.site.state,
        })}
      />
    ) : null
  }

  <p>
    <a href="/">All roles</a> &middot; <a href={`/tier-list/${slug}`}>{label} tier list</a> &middot;{' '}
    <a href="/about">How these numbers are produced</a>
  </p>
</article>
