---
// The site shell, with the Props frozen in docs/contracts.md section 3.
//
// It renders <html>, imports the design system's tokens.css, then the state
// banner, Nav, the default slot and Footer. Reading the build-time site state
// here is what keeps the provenance banner on every route without each page
// having to remember it; it reads files at build time and never fetches
// anything, so no route depends on JavaScript for its content.
//
// tokens.css pulls in global.css itself, so it is the only stylesheet import
// the contract names and the only one needed. The layout's own sheet styles the
// fallback components in layouts/fallback/, which are used only if a frozen
// component is missing from web/src/components.

import '../styles/tokens.css';
import './fallback/base.css';

import type { Window } from '../types/agg';
import { componentOr } from '../lib/components';
import { siteData, stateBanner } from '../lib/site';
import FallbackFooter from './fallback/Footer.astro';
import FallbackNav from './fallback/Nav.astro';
import StateBanner from './StateBanner.astro';

interface Props {
  title: string;
  description: string;
  patch: string;
  canonical?: string;
  generatedAt?: string;
  active?: string;
  noindex?: boolean;
}

const { title, description, patch, canonical, generatedAt, active, noindex = false } = Astro.props;

const Nav = await componentOr('Nav', FallbackNav);
const Footer = await componentOr('Footer', FallbackFooter);

const site = siteData();
const banner = stateBanner(site);
const sourceWindow: Window | undefined = site.sourceWindow ?? undefined;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="LoL Stats" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {/*
      The two faces every page paints above the fold are preloaded from this
      origin; the @font-face rules that name them live in styles/fonts.css (the
      design system owns those file names, which is why they are literal here).
      No font is ever fetched from a third-party host, so a visitor's IP is not
      disclosed to one and the page paints without a second DNS lookup.
    */}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-400.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-600.woff2" crossorigin />
  </head>
  <body data-state={site.state} data-source={site.source ?? 'none'}>
    <a class="fallback-skip" href="#main">Skip to content</a>
    <StateBanner
      banner={banner}
      patch={patch}
      generatedAt={generatedAt ?? site.latest?.generated_at}
      sourceWindow={sourceWindow}
      minCellN={site.minCellN}
      suppressedCells={site.suppressedCells}
    />
    <Nav patch={patch} active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer patch={patch} generatedAt={generatedAt ?? site.latest?.generated_at} sourceWindow={sourceWindow} />
  </body>
</html>
