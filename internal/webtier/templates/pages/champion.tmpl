{{ define "page:champion" }}<article>{{ template "championBody" . }}</article>{{ if .NoCellsNotice }}<p>{{ .NoCellsNotice }}</p>{{ end }}{{ end }}
{{ define "championBody" }}<h1>{{ .Headline }}</h1>{{ if .IconURL }}<img class="fallback-champion-icon" src="{{ .IconURL }}" alt="{{ .IconAlt }}" width="64" height="64" loading="lazy" decoding="async">{{ end }}<p>{{ .Intro }}</p>{{ if .HasPartition }}<p>Bracket {{ .Bracket }} &middot; source window {{ .Window }} &middot; generated {{ .Generated }}</p>{{ end }}{{ if .HasOtherRoles }}<h2>Other roles in this snapshot</h2>{{ template "championLinks" .OtherRoles }}{{ end }}{{ if .HasStats }}<h2>{{ .StatsHeading }}</h2>{{ template "sampleSizeNotice" .Notice }}<p class="fallback-stat-row">{{ range .Stats }}{{ template "fallbackStatValue" . }}{{ end }}</p><p>{{ if .HasTier }}Tier {{ template "fallbackTierBadge" .TierBadge }} {{ end }}{{ .TierSentence }}</p>{{ else }}{{ template "emptyState" .Empty }}{{ end }}{{ if .HasRoles }}<h2>Roles</h2>{{ template "fallbackDataTable" .Roles }}{{ if .HasDepth }}{{ template "championLinks" .Depth }}{{ end }}{{ end }}{{ if .Builds }}<h2>Items, runes and spells</h2>{{ range .Builds }}{{ template "dsBuildList" . }}{{ end }}<p>Builds are the combinations the artifact recorded most often, already ordered by number of games. They are counts of what was played, not a recommendation: this site publishes what happened, and nothing here is a suggestion about what to buy.</p>{{ end }}{{ if .HasSkillOrders }}<h2>Skill orders</h2>{{ template "fallbackDataTable" .SkillOrders }}{{ end }}{{ if .HasMatchups }}<h2>Matchups</h2>{{ if .HasPairRows }}<p>{{ .MatchupIntro }}</p>{{ template "fallbackDataTable" .MatchupTable }}{{ else }}{{ template "emptyState" .MatchupEmpty }}{{ end }}<p><a href="{{ .MatchupPath }}">The full {{ .MatchupRoleLower }} matchup matrix</a></p>{{ end }}<h2>{{ .ComputedHeading }}</h2><p>{{ .ComputedSentence }}</p><p><a href="/">All roles</a> &middot; <a href="{{ .NavOverviewHref }}">{{ .NavOverviewText }}</a> &middot; <a href="/about">How these numbers are produced</a></p>{{ end }}
