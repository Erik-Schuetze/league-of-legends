---
// The page's own implementation of the frozen `SampleSizeNotice` API. This is a
// compliance requirement rather than decoration (docs/contracts.md section 3,
// plan section 3.3): every page of statistics says how many games it rests on,
// what the publication threshold is, and how many cells were withheld.

import type { Role } from '../../types/agg';
import { integer } from '../../lib/format';
import { roleLabel } from '../../lib/roles';

interface Props {
  n: number;
  minCellN: number;
  suppressedCells?: number;
  role?: Role;
}

const { n, minCellN, suppressedCells, role } = Astro.props;
const scope = role ? ` in ${roleLabel(role)}` : '';
---

<p class="fallback-sample-size-notice">
  {
    n > 0 ? (
      <>
        Sample: <strong>n = {integer(n)}</strong> games{scope} in this snapshot. A win, pick or ban rate is published
        only where a cell holds at least n = {integer(minCellN)} games.
      </>
    ) : (
      <>
        No sample yet{scope}: this snapshot holds no games for this selection, so no rate can be published.
      </>
    )
  }
  {
    suppressedCells !== undefined && suppressedCells > 0 && (
      <>
        {' '}
        The aggregator withheld {integer(suppressedCells)} further cell
        {suppressedCells === 1 ? '' : 's'} below that threshold.
      </>
    )
  }
</p>
