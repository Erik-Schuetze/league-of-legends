---
// The page's own implementation of the frozen `BuildList` API: docs/contracts.md
// section 3, plus the optional `lookup` prop frozen in
// docs/decisions/ADR-006-component-api-extensions.md.
//
// Used when web/src/components/BuildList.astro is absent - or, more often today,
// when it is present but does not declare `lookup`, which is the only way a
// `Build.key` id becomes the item, rune or spell it names. The frozen API says
// the component renders "the icon row derived from Build.key", so a component
// that cannot is not usable for this call site and the page falls back to this
// one, which can.
//
// The aggregator's ordering is rendered as-is (already sorted by n descending);
// nothing is re-sorted. Keys with no entry in the lookup stay numeric chips, per
// key, so a build whose items are partly unknown still renders its row.
//
// No client script: every row, icon included, is in the HTML.

import type { Build } from '../../types/agg';
import type { BuildLookup } from '../../lib/build-lookup';
import { buildRows } from '../../lib/rows';
import { integer, percent } from '../../lib/format';

interface Props {
  title: string;
  builds: Build[];
  kind: 'items' | 'runes' | 'spells';
  lookup?: BuildLookup;
  limit?: number;
  emptyMessage?: string;
}

const {
  title,
  builds,
  kind,
  lookup,
  limit = 10,
  emptyMessage = 'No build was published for this selection.',
} = Astro.props;

// `buildRows` truncates with the same `slice(0, limit)`, so the two lists line
// up index for index.
const rows = buildRows(builds, limit, 0);
const shown = builds.slice(0, limit);

const kindLabel = kind === 'items' ? 'item' : kind === 'runes' ? 'rune' : 'summoner spell';

const value = (input: number | string): string => (typeof input === 'number' ? percent(input, 2) : input);
---

<section class="fallback-build-list">
  <h3>{title}</h3>
  {
    shown.length === 0 ? (
      <p class="fallback-build-list__empty">{emptyMessage}</p>
    ) : (
      <ol class="fallback-build-rows">
        {shown.map((build, index) => (
          <li class="fallback-build-row">
            <span class="fallback-build-row__icons">
              {build.key.map((id) => {
                const entry = lookup?.[kind][id];
                return entry ? (
                  <img
                    class="fallback-build-row__icon"
                    src={entry.icon}
                    alt={entry.name}
                    width="32"
                    height="32"
                    loading="lazy"
                  />
                ) : (
                  <span class="fallback-build-row__chip" aria-hidden="true">
                    {id}
                  </span>
                );
              })}
            </span>
            <span class="fallback-build-row__label">{build.label}</span>
            <span class="fallback-build-row__stats">
              <span class="fallback-build-row__n">n = {integer(build.n)}</span>
              <span class="fallback-build-row__rate">{value(rows[index]?.win_rate ?? 'no sample')}</span>
            </span>
            <span class="fallback-build-row__kind">
              {kindLabel} key: {build.key.join(', ')}
            </span>
          </li>
        ))}
      </ol>
    )
  }
</section>

<style>
  .fallback-build-list {
    margin: 0 0 1.5rem;
  }

  .fallback-build-list__empty {
    margin: 0;
    color: var(--text-muted, #5a5a5a);
  }

  .fallback-build-rows {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fallback-build-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.4rem 1rem;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--hairline, #dddddd);
  }

  .fallback-build-row:first-child {
    border-top: 1px solid var(--hairline, #dddddd);
  }

  .fallback-build-row__icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
  }

  .fallback-build-row__icon {
    display: block;
    border: 1px solid var(--hairline, #dddddd);
  }

  .fallback-build-row__chip {
    min-width: 2.4em;
    padding: 0 0.25em;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    text-align: center;
    color: var(--primary-color, #0a5c8a);
    background-color: var(--bg-color, #ffffff);
    border: 1px solid var(--hairline, #dddddd);
  }

  .fallback-build-row__label {
    grid-column: 1;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    color: var(--text-muted, #5a5a5a);
    overflow-wrap: anywhere;
  }

  .fallback-build-row__stats {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: flex;
    gap: 1rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .fallback-build-row__kind {
    clip-path: inset(50%);
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    white-space: nowrap;
  }
</style>
