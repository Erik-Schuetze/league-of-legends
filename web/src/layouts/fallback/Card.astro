---
// The page's own implementation of the frozen `Card` API
// (docs/contracts.md section 3): title, href?, tone?, sampleN? and a default
// slot. Used only when web/src/components/Card.astro is absent, so a page can
// be written once against the frozen props and still render.

import { integer } from '../../lib/format';

interface Props {
  title: string;
  href?: string;
  tone?: 'default' | 'accent';
  sampleN?: number;
}

const { title, href, tone = 'default', sampleN } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['fallback-card', `fallback-card--${tone}`, href ? 'fallback-card--link' : null]} href={href}>
  <h3 class="fallback-card__title">{title}</h3>
  <div class="fallback-card__body"><slot /></div>
  {sampleN !== undefined && <p class="fallback-card__sample">Sample size n = {integer(sampleN)} games.</p>}
</Tag>
