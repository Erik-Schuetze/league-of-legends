---
import type { Role } from '../types/agg';
import { integer } from '../lib/format';
import { roleLabel } from '../lib/roles';

interface Props {
  n: number;
  minCellN: number;
  suppressedCells?: number;
  role?: Role;
}

const { n, minCellN, suppressedCells = 0, role } = Astro.props;
---

<p class="notice" data-suppressed={suppressedCells > 0 ? 'true' : 'false'}>
  <span class="lead">Sample</span>
  <span class="v">{integer(n)}</span> matches{role ? ` in ${roleLabel(role)}` : ''}, judged against a minimum cell size of
  <span class="v">{integer(minCellN)}</span> matches.
  {
    suppressedCells > 0 && (
      <span class="suppressed">
        {integer(suppressedCells)} {suppressedCells === 1 ? 'cell was' : 'cells were'} withheld for falling below that
        threshold.
      </span>
    )
  }
</p>

<style>
  .notice {
    margin: 0 0 var(--space-3);
    padding: var(--space-2) var(--space-3);
    font-size: var(--fs-sm);
    color: var(--text-color);
    background-color: var(--bg-light);
    /* A drawn edge rather than a radius: the system has no rounded corners. */
    border-left: var(--border-width) solid var(--accent-color);
  }

  .lead {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--primary-color);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--fs-xs);
    margin-right: 0.25rem;
  }

  .v {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--primary-color);
  }

  .suppressed {
    display: block;
    margin-top: 0.15rem;
    color: var(--primary-color);
    /* A withheld cell is a data-quality signal, so it is marked with weight and
       a rule as well as the accent edge - never by colour alone. */
    border-top: 1px dotted var(--hairline);
    padding-top: 0.15rem;
  }

  @media print {
    .notice {
      border-left-color: var(--print-ink);
    }
  }
</style>
