---
// /champions/<slug>/<role> - one champion in one role, in depth.
//
// The role set is the roles the champion actually has a sample in. When no
// snapshot exists there is no role with a sample, so the route is generated for
// all five roles and each renders the explicit empty state: the URLs a reader
// will bookmark exist before the numbers behind them do.

import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChampionBody from '../../../layouts/ChampionBody.astro';
import type { Role, StaticChampion } from '../../../types/agg';
import { roleLabel, roleSlug } from '../../../lib/roles';
import {
  championFor,
  championRolePages,
  matchupsFor,
  patchLabel,
  snapshot,
  tierListFor,
} from '../../../lib/page';

// The same enumeration the sitemap uses, so the route set the build renders and
// the route set the sitemap advertises cannot disagree.
export function getStaticPaths() {
  return championRolePages().map((entry) => ({
    params: { slug: entry.champion.slug, role: roleSlug(entry.role) },
    props: { champion: entry.champion, role: entry.role },
  }));
}

interface Props {
  champion: StaticChampion;
  role: Role;
}

const { champion, role } = Astro.props;
const label = roleLabel(role);
const slug = roleSlug(role);

const snap = snapshot();
const tierList = tierListFor(snap);
const artifact = championFor(snap, champion.id);
const cells = tierList ? tierList.cells.filter((cell) => cell.champion_id === champion.id) : [];
const matchups = matchupsFor(snap, role);

const partition = snap.partition;
const title = partition
  ? `${champion.name} ${label} build, runes and matchups, patch ${partition.patch} - LoL Stats`
  : `${champion.name} ${label} statistics - League of Legends - LoL Stats`;
const description = partition
  ? `${champion.name} in ${label.toLowerCase()}: win, pick and ban rates, common builds, runes and matchup win ` +
    `rates for League of Legends patch ${partition.patch}, each with the games behind it.`
  : `${champion.name} ${label.toLowerCase()} statistics are not published yet: no aggregate snapshot exists for this ` +
    `site, so this page renders an explicit empty state.`;

const hasStats = artifact?.roles.some((entry) => entry.role === role) ?? false;
const hasCell = cells.some((cell) => cell.role === role);
---

<BaseLayout
  title={title}
  description={description}
  patch={patchLabel(snap)}
  canonical={`/champions/${champion.slug}/${slug}/`}
  generatedAt={snap.generatedAt}
  active={`/champions/${champion.slug}/${slug}`}
  noindex={!hasStats && !hasCell}
>
  <ChampionBody snap={snap} champion={champion} cells={cells} artifact={artifact} role={role} matchups={matchups} />
</BaseLayout>
