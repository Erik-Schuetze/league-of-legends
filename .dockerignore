# Keep the build context to source only. Everything below is either
# regenerable, local-only, or irrelevant to `go build`, and shipping it would
# slow the build and widen the set of bytes the daemon has to look at.
.git
.github
.agent-artifacts
docs
deploy
# `web` is excluded except for the demo tree the Go web tier renders at runtime
# with LOLSTATS_AGG_FIXTURES=only (see the Dockerfile). Docker's ignore rules are
# last-match-wins, so each path that has to stay in the context needs its parents
# re-included first.
web/*
!web/src
web/src/*
!web/src/fixtures
fixtures
*.md
bin
node_modules

# Secrets never enter a build context, even though nothing here copies them.
.env
*.pem
*.key
