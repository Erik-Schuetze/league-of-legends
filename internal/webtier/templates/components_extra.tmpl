{{ define "comparePanel" }}<section class="fallback-compare" aria-label="Compare champions"><h3 data-astro-cid-2t5tmnod>Comparing {{ .Heading }}</h3><table class="fallback-data-table" data-astro-cid-2t5tmnod><caption data-astro-cid-2t5tmnod>Side by side, from the same snapshot and the same threshold as the table above. Every cell is a measurement that was taken once, not a second computation of it.</caption><thead data-astro-cid-2t5tmnod><tr data-astro-cid-2t5tmnod><th scope="col" data-astro-cid-2t5tmnod>Champion</th>{{ range .Columns }}<th scope="col"{{ if .Numeric }} class="num"{{ end }} data-astro-cid-2t5tmnod>{{ .Label }}</th>{{ end }}</tr></thead><tbody data-astro-cid-2t5tmnod>{{ range .Rows }}<tr data-v-champion="{{ .Name }}" data-v-role="{{ .RoleAttr }}" data-v-n="{{ .NAttr }}" data-v-win_rate="{{ .WinRateAttr }}" data-v-pick_rate="{{ .PickRateAttr }}" data-v-ban_rate="{{ .BanRateAttr }}" data-v-ci95="{{ .CI95Attr }}" data-astro-cid-2t5tmnod><th scope="row" data-astro-cid-2t5tmnod><a href="{{ .Href }}" data-astro-cid-2t5tmnod>{{ .Name }}</a></th>{{ if .Published }}<td class="num" data-astro-cid-2t5tmnod>{{ .NText }}</td><td class="num" data-astro-cid-2t5tmnod>{{ .WinRateText }}</td><td class="num" data-astro-cid-2t5tmnod>{{ .PickRateText }}</td><td class="num" data-astro-cid-2t5tmnod>{{ .BanRateText }}</td><td class="num ci" data-astro-cid-2t5tmnod>{{ .CI95Text }}</td>{{ else }}<td class="num" data-astro-cid-2t5tmnod>{{ .NText }}</td><td class="num unavailable" data-astro-cid-2t5tmnod>{{ .Unavailable }}</td><td class="num unavailable" data-astro-cid-2t5tmnod>{{ .Unavailable }}</td><td class="num unavailable" data-astro-cid-2t5tmnod>{{ .Unavailable }}</td><td class="num unavailable" data-astro-cid-2t5tmnod>{{ .Unavailable }}</td>{{ end }}</tr>{{ end }}</tbody></table>{{ if .Missing }}<p class="fallback-compare__missing" data-astro-cid-2t5tmnod>No champion matching {{ .Missing }} has a published cell in this snapshot, so nothing is compared for {{ if .MissingOne }}it{{ else }}them{{ end }} rather than a blank row being invented.</p>{{ end }}<p data-astro-cid-2t5tmnod>{{ .Note }}</p></section>{{ end }}
