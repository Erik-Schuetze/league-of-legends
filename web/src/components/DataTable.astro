---
import { decimal, integer, percent } from '../lib/format';

type CellValue = string | number | null;
type Row = Record<string, CellValue>;

interface Column {
  key: string;
  label: string;
  align?: 'start' | 'end';
  sortable?: boolean;
  format?: 'text' | 'percent' | 'integer' | 'decimal';
  digits?: number;
}

interface Props {
  columns: Column[];
  rows: Row[];
  caption?: string;
  initialSortKey?: string;
  initialSortDir?: 'asc' | 'desc';
  emptyMessage?: string;
  dense?: boolean;
}

const {
  columns,
  rows,
  caption,
  initialSortKey,
  initialSortDir = 'desc',
  emptyMessage = 'No data for this selection.',
  dense = false,
} = Astro.props;

const isNumeric = (column: Column) =>
  column.format === 'percent' || column.format === 'integer' || column.format === 'decimal';

const isMissing = (value: CellValue | undefined): boolean => value === null || value === undefined;

const display = (value: CellValue | undefined, column: Column): string => {
  if (isMissing(value)) return '';
  const { format = 'text', digits = 2 } = column;
  if (typeof value !== 'number') return value;
  if (format === 'percent') return percent(value, digits);
  if (format === 'integer') return integer(value);
  if (format === 'decimal') return decimal(value, digits);
  return String(value);
};

// Missing values sort last in both directions: "no data" is not the smallest
// number, and a descending sort should not open with a wall of dashes.
const sortValues = (a: CellValue | undefined, b: CellValue | undefined): number => {
  if (isMissing(a)) return 1;
  if (isMissing(b)) return -1;
  if (typeof a === 'number' && typeof b === 'number') return a - b;
  return String(a).localeCompare(String(b), 'en');
};

const sortKey =
  initialSortKey && columns.some((column) => column.key === initialSortKey) ? initialSortKey : undefined;

const sorted = [...rows];
if (sortKey) {
  const direction = initialSortDir === 'asc' ? 1 : -1;
  sorted.sort((left, right) => {
    const a = left[sortKey];
    const b = right[sortKey];
    if (isMissing(a) || isMissing(b)) return isMissing(a) === isMissing(b) ? 0 : isMissing(a) ? 1 : -1;
    return sortValues(a, b) * direction;
  });
}

const ariaSort = (column: Column): 'ascending' | 'descending' | 'none' | undefined => {
  if (!sortKey) return undefined;
  if (column.key !== sortKey) return undefined;
  return initialSortDir === 'asc' ? 'ascending' : 'descending';
};
---

<div class="wrap">
  <table class:list={['table', { dense }]}>
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        {
          columns.map((column) => (
            <th
              scope="col"
              class:list={[{ num: column.align === 'end' || isNumeric(column) }]}
              aria-sort={ariaSort(column)}
              data-sortable={column.sortable ? 'true' : undefined}
            >
              {column.label}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        sorted.length === 0 ? (
          <tr>
            <td colspan={columns.length} class="empty">
              {emptyMessage}
            </td>
          </tr>
        ) : (
          sorted.map((row) => (
            <tr>
              {columns.map((column) =>
                isMissing(row[column.key]) ? (
                  <td class:list={['is-missing', { num: column.align === 'end' || isNumeric(column) }]}>
                    <span aria-hidden="true">&mdash;</span>
                    <span class="ds-visually-hidden">not published</span>
                  </td>
                ) : (
                  <td class:list={[{ num: column.align === 'end' || isNumeric(column) }]}>
                    {display(row[column.key], column)}
                  </td>
                ),
              )}
            </tr>
          ))
        )
      }
    </tbody>
  </table>
</div>

<style>
  .wrap {
    overflow-x: auto;
    max-width: 100%;
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    /* Dense by default: statistics are read by scanning a column, not a line. */
    line-height: var(--line-tight);
  }

  caption {
    padding: 0 0 var(--space-2);
    font-family: var(--font-heading);
    font-size: var(--fs-sm);
    color: var(--primary-color);
    text-align: left;
  }

  th {
    padding: var(--row-pad-y) var(--row-pad-x);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-on-dark);
    background-color: var(--primary-color);
    white-space: nowrap;
  }

  td {
    padding: var(--row-pad-y) var(--row-pad-x);
    vertical-align: baseline;
    border-bottom: 1px solid var(--hairline);
  }

  tbody tr:nth-child(even) td {
    background-color: var(--stripe);
  }

  .num {
    text-align: right;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .table.dense th,
  .table.dense td {
    padding: var(--row-pad-y-dense) var(--row-pad-x-dense);
  }

  .is-missing {
    color: var(--text-muted);
  }

  .empty {
    padding: var(--space-4) var(--row-pad-x);
    color: var(--text-muted);
    text-align: left;
  }

  @media print {
    th {
      color: var(--print-ink);
      background-color: transparent;
      border-bottom: var(--border-width) solid var(--print-ink);
    }

    tbody tr:nth-child(even) td {
      background-color: transparent;
    }
  }
</style>
