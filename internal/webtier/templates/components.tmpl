{{ define "tierBadge" }}<span class="tier" data-astro-cid-n644qoiz><span class="badge grade-{{ .Grade }}" data-tier="{{ .Tier }}" data-astro-cid-n644qoiz><span class="ds-visually-hidden" data-astro-cid-n644qoiz>Tier </span>{{ .Tier }}</span></span>{{ end }}
{{ define "fallbackTierBadge" }}<span class="fallback-tier-badge fallback-tier-badge--{{ .Grade }}" title="{{ .Title }}">{{ .Tier }}</span>{{ end }}
{{ define "fallbackDataTable" }}<table class="fallback-data-table"><caption>{{ .Caption }}</caption><thead><tr>{{ range .Columns }}<th scope="col"{{ if .End }} class="fallback-is-end"{{ end }}>{{ .Label }}</th>{{ end }}</tr></thead><tbody>{{ range .Rows }}<tr>{{ range .Cells }}<td{{ if .End }} class="fallback-is-end"{{ end }}>{{ .Text }}</td>{{ end }}</tr>{{ end }}</tbody></table>{{ end }}
{{ define "championLinks" }}<ul class="fallback-champion-links">{{ range . }}<li><a href="{{ .Href }}">{{ .Name }}</a></li>{{ end }}</ul>{{ end }}
{{ define "sampleSizeNotice" }}<p class="fallback-sample-size-notice">{{ if gt .N 0 }}Sample: <strong>n = {{ .NText }}</strong> games{{ .Scope }} in this snapshot. A win, pick or ban rate is published only where a cell holds at least n = {{ .MinCellNText }} games.{{ else }}No sample yet{{ .Scope }}: this snapshot holds no games for this selection, so no rate can be published.{{ end }}{{ if gt .Suppressed 0 }} {{ .SuppressedText }} further cell{{ .SuppressedPlural }} below that threshold {{ .SuppressedIs }} withheld from the artifact.{{ end }}</p>{{ end }}
{{ define "patchSwitcher" }}<nav class="fallback-patch-switcher-nav" aria-label="Patch"><ul class="fallback-patch-switcher">{{ range . }}<li><a href="{{ .Href }}"{{ if .Current }} aria-current="page" title="the patch this page shows"{{ else }} title="switch to patch {{ .Patch }}"{{ end }}>{{ .Patch }}</a></li>{{ end }}</ul></nav>{{ end }}
{{ define "emptyState" }}<div class="fallback-empty" role="note"><p><strong>{{ .Title }}</strong></p><p>{{ .Body }}</p>{{ if .HasMinCellN }}<p>A rate is published only for a cell with at least n = {{ .MinCellN }} games. Nothing here is estimated or back-filled from a thinner sample.</p>{{ end }}</div>{{ end }}
{{ define "tableIsland" }}<div class="island" data-island="table" data-astro-cid-zt6f6xwj><div class="controls ds-print-hidden" data-ti-controls hidden data-astro-cid-zt6f6xwj><p class="field" data-astro-cid-zt6f6xwj><label for="{{ .UID }}-filter" data-astro-cid-zt6f6xwj>Filter champions</label><input id="{{ .UID }}-filter" type="search" data-ti-filter autocomplete="off" data-astro-cid-zt6f6xwj></p><p class="field" data-astro-cid-zt6f6xwj><label for="{{ .UID }}-sort" data-astro-cid-zt6f6xwj>Sort by</label><select id="{{ .UID }}-sort" data-ti-sort data-astro-cid-zt6f6xwj>{{ range .Cols }}<option value="{{ .Key }}"{{ if eq .Key $.SortKey }} selected{{ end }} data-astro-cid-zt6f6xwj>{{ .Label }}</option>{{ end }}</select></p><button type="button" class="toggle" data-ti-dir data-dir="{{ .Dir }}" aria-label="Sort direction: {{ .DirLabel }}. Activate to reverse." data-astro-cid-zt6f6xwj>{{ .DirText }}</button></div><p class="status ds-print-hidden" data-ti-status role="status" data-astro-cid-zt6f6xwj>{{ .StatusText }}</p><div class="wrap" data-astro-cid-zt6f6xwj><table data-astro-cid-zt6f6xwj><caption data-astro-cid-zt6f6xwj>{{ .Caption }}</caption><thead data-astro-cid-zt6f6xwj><tr data-astro-cid-zt6f6xwj>{{ range .Cols }}<th scope="col" data-col="{{ .Key }}"{{ if eq .Key $.SortKey }} aria-sort="{{ $.AriaSort }}"{{ end }}{{ if .Numeric }} class="num"{{ end }} data-astro-cid-zt6f6xwj>{{ .Label }}</th>{{ end }}</tr></thead><tbody data-astro-cid-zt6f6xwj>{{ if .Rows }}{{ range .Rows }}<tr data-search="{{ .Search }}" data-v-champion="{{ .Name }}" data-v-role="{{ .RoleAttr }}" data-v-tier="{{ .TierAttr }}" data-v-n="{{ .NAttr }}" data-v-win_rate="{{ .WinRateAttr }}" data-v-pick_rate="{{ .PickRateAttr }}" data-v-ban_rate="{{ .BanRateAttr }}" data-v-ci95="{{ .CI95Attr }}" data-astro-cid-zt6f6xwj><td class="champion" data-astro-cid-zt6f6xwj><img src="{{ .IconURL }}" alt="" width="24" height="24" loading="lazy" decoding="async" data-astro-cid-zt6f6xwj><a class="name" href="{{ .Href }}" data-astro-cid-zt6f6xwj>{{ .Name }}</a></td><td class="tier-cell" data-astro-cid-zt6f6xwj>{{ if .TierPublished }}{{ template "tierBadge" (.Badge) }}{{ end }}</td><td class="num" data-astro-cid-zt6f6xwj>{{ .NText }}</td>{{ if .Published }}<td class="num" data-astro-cid-zt6f6xwj>{{ .WinRateText }}</td><td class="num" data-astro-cid-zt6f6xwj>{{ .PickRateText }}</td><td class="num" data-astro-cid-zt6f6xwj>{{ .BanRateText }}</td><td class="num ci" data-astro-cid-zt6f6xwj>{{ .CI95Text }}</td>{{ else }}<td class="num unavailable" data-astro-cid-zt6f6xwj>{{ .Unavailable }}</td><td class="num unavailable" data-astro-cid-zt6f6xwj>{{ .Unavailable }}</td><td class="num unavailable" data-astro-cid-zt6f6xwj>{{ .Unavailable }}</td><td class="num unavailable" data-astro-cid-zt6f6xwj>{{ .Unavailable }}</td>{{ end }}</tr>{{ end }}{{ else }}<tr data-astro-cid-zt6f6xwj><td colspan="{{ .ColCount }}" class="empty" data-astro-cid-zt6f6xwj>No champion has a published cell for this selection.</td></tr>{{ end }}</tbody></table></div><p class="note ds-print-hidden" data-astro-cid-zt6f6xwj>{{ .Note }}</p></div>{{ end }}
{{ define "fallbackStatValue" }}{{ if .Unavailable }}<span class="fallback-stat"><span class="fallback-stat__value fallback-stat__value--unavailable">-</span><span class="fallback-stat__reason">not published: the sample is below the threshold for this cell</span></span>{{ else }}<span class="fallback-stat">{{ if .HasLabel }}<span class="fallback-stat__label">{{ .Label }}</span>{{ end }}<span class="fallback-stat__value">{{ .Value }}</span>{{ if .HasN }}<span class="fallback-stat__n">n = {{ .N }}</span>{{ end }}</span>{{ end }}{{ end }}
{{ define "dsStatValue" }}<span class="stat" data-format="{{ .Format }}" data-astro-cid-owrb7bwm><span class="label" data-astro-cid-owrb7bwm>{{ .Label }}</span><span class="value" data-astro-cid-owrb7bwm>{{ .Value }}</span></span>{{ end }}
{{ define "dsBuildList" }}<section class="ds-build-list" data-astro-cid-hqssc25b><h3 class="title" data-astro-cid-hqssc25b>{{ .Title }}</h3>{{ if .Rows }}<ol class="rows" role="list" data-astro-cid-hqssc25b>{{ range .Rows }}<li class="row" data-astro-cid-hqssc25b><span class="key" data-astro-cid-hqssc25b>{{ range .Keys }}{{ if .HasImg }}<img class="icon" src="{{ .Icon }}" alt="{{ .Name }}" width="24" height="24" loading="lazy" data-astro-cid-hqssc25b>{{ else }}<span class="chip" data-astro-cid-hqssc25b>{{ .ID }}</span>{{ end }}{{ end }}</span><span class="label" data-astro-cid-hqssc25b>{{ .Label }}</span><span class="stats" data-astro-cid-hqssc25b>{{ template "dsStatValue" .Matches }}{{ template "dsStatValue" .Win }}</span></li>{{ end }}</ol>{{ else }}<p class="empty" data-astro-cid-hqssc25b>{{ .EmptyMessage }}</p>{{ end }}</section>{{ end }}
