}</td><td class="num ci" data-astro-cid-zt6f6xwj>{{ .CI95Text }}</td>{{ else }}<td class="num unavailable" data-astro-cid-zt6f6xwj>{{ .Unavailable }}</td><td class="num unavailable" data-astro-cid-zt6f6xwj>{{ .Unavailable }}</td><td class="num unavailable" data-astro-cid-zt6f6xwj>{{ .Unavailable }}</td><td class="num unavailable" data-astro-cid-zt6f6xwj>{{ .Unavailable }}</td>{{ end }}</tr>{{ end }}{{ else }}<tr data-astro-cid-zt6f6xwj><td colspan="{{ .Island.ColCount }}" class="empty" data-astro-cid-zt6f6xwj>No champion has a published cell for this selection.</td></tr>{{ end }}</tbody></table></div><p class="note ds-print-hidden" data-astro-cid-zt6f6xwj>{{ .Island.Note }}</p></div>{{ if .HasPageNav }}{{ template "nojsPager" .PageNav }}{{ end }}<script type="module" src="/_astro/TableIsland.astro_astro_type_script_index_0_lang.UqXLqAt9.js"></script><p>{{ .Note }}</p>{{ if .HasUnmeasured }}<p>{{ .UnmeasuredNote }}</p>{{ end }}{{ else }}{{ template "emptyState" .Empty }}{{ end }}<h2>Downloads</h2><p>{{ .ExportNote }}</p><ul>{{ range .Exports }}<li><a href="{{ .Href }}">{{ .Name }}</a></li>{{ end }}</ul>{{ if .Links }}<h2>Champion pages in this view</h2>{{ template "championLinks" .Links }}{{ end }}<h2>What this table is</h2><p>{{ .Tail }}</p><p><a href="/">Tier list</a> &middot; <a href="/about">How these numbers are produced</a></p></article>{{- end -}}
