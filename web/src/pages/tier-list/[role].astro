---
// /tier-list/<role> - the newest published snapshot, one role.
//
// Patch switching is a link between pre-generated snapshots, so this route and
// /patch/<version>/tier-list/<role> share one body: the only difference is which
// partition the page was rendered from.

import BaseLayout from '../../layouts/BaseLayout.astro';
import TierListBody from '../../layouts/TierListBody.astro';
import type { Role } from '../../types/agg';
import { ROLES, roleLabel, roleSlug } from '../../lib/roles';
import { patchLabel, snapshot, statisticsNoindex, tierListFor } from '../../lib/page';
import { absoluteUrl } from '../../lib/seo';

export function getStaticPaths() {
  return ROLES.map((role) => ({ params: { role: roleSlug(role) }, props: { role } }));
}

interface Props {
  role: Role;
}

const { role } = Astro.props;
const label = roleLabel(role);
const slug = roleSlug(role);

const snap = snapshot();
const tierList = tierListFor(snap);
const url = absoluteUrl(`/tier-list/${slug}/`, Astro.site, Astro.url);

const partition = snap.partition;
const title = partition
  ? `${label} tier list, patch ${partition.patch} - League of Legends - LoL Stats`
  : `${label} tier list - League of Legends - LoL Stats`;
const description = partition
  ? `${label} champion win, pick and ban rates for League of Legends patch ${partition.patch}, ` +
    `${partition.region} ranked solo queue, each with its sample size and a 95% interval. ` +
    `Rates are published only for cells holding at least ${partition.min_cell_n} games.`
  : `The ${label.toLowerCase()} tier list is not published yet: no aggregate snapshot exists for this site, ` +
    `so this page renders an explicit empty state and fills in as soon as one does.`;
---

<BaseLayout
  title={title}
  description={description}
  patch={patchLabel(snap)}
  canonical={`/tier-list/${slug}/`}
  generatedAt={snap.generatedAt}
  active={`/tier-list/${slug}`}
  noindex={statisticsNoindex(snap)}
>
  <TierListBody snap={snap} role={role} tierList={tierList} url={url} />
</BaseLayout>
