{{- /* heatmapIsland is web/src/components/HeatmapIsland.astro. The reference build
renders the whole matrix server-side, so this is the component's markup with the grid
loops substituted; the transformation asserted each substitution. */ -}}
{{ define "heatmapIsland" }}<div class="island" data-island="heatmap" data-min-n="{{ .MinCellN }}" data-astro-cid-5wqubv3u><p class="detail ds-print-hidden" data-hm-detail role="status" data-astro-cid-5wqubv3u>Point at, tap or tab into a cell to read the pairing in full; the arrow keys move through the grid, and the first column names the champion in each row.</p><ul class="legend ds-print-hidden" data-astro-cid-5wqubv3u><li data-astro-cid-5wqubv3u><span class="swatch up-strong" aria-hidden="true" data-astro-cid-5wqubv3u></span><span class="num" data-astro-cid-5wqubv3u>+5.0</span> or more above even</li><li data-astro-cid-5wqubv3u><span class="swatch up" aria-hidden="true" data-astro-cid-5wqubv3u></span><span class="num" data-astro-cid-5wqubv3u>0</span> to <span class="num" data-astro-cid-5wqubv3u>+5.0</span> above even</li><li data-astro-cid-5wqubv3u><span class="swatch level" aria-hidden="true" data-astro-cid-5wqubv3u></span>level: within 0.5 of even</li><li data-astro-cid-5wqubv3u><span class="swatch down" aria-hidden="true" data-astro-cid-5wqubv3u></span><span class="num" data-astro-cid-5wqubv3u>0</span> to <span class="num" data-astro-cid-5wqubv3u>-5.0</span> below even</li><li data-astro-cid-5wqubv3u><span class="swatch down-strong" aria-hidden="true" data-astro-cid-5wqubv3u></span><span class="num" data-astro-cid-5wqubv3u>-5.0</span> or more below even (hatched)</li><li data-astro-cid-5wqubv3u><span class="swatch missing" aria-hidden="true" data-astro-cid-5wqubv3u></span>not published: no cell in the artifact, or under n = {{ .MinCellN }} games (faintly hatched)</li></ul><div class="wrap" data-astro-cid-5wqubv3u><table data-astro-cid-5wqubv3u><caption data-astro-cid-5wqubv3u>{{ .Caption }}</caption><thead data-astro-cid-5wqubv3u><tr data-astro-cid-5wqubv3u><th scope="col" class="corner" data-astro-cid-5wqubv3u>Champion</th>{{ range .Columns }}<th scope="col" class="column" data-champion="{{ .ID }}" data-astro-cid-5wqubv3u>{{ .Name }}</th>{{ end }}</tr></thead><tbody data-astro-cid-5wqubv3u>{{ range .Rows }}<tr data-astro-cid-5wqubv3u><th scope="row" class="row-head" data-champion="{{ .ID }}" data-astro-cid-5wqubv3u>{{ if .Href }}<a href="{{ .Href }}" data-astro-cid-5wqubv3u>{{ .Name }}</a>{{ else }}<span data-astro-cid-5wqubv3u>{{ .Name }}</span>{{ end }}</th>{{ range .Cells }}{{ .Markup }}{{ end }}</tr>{{ end }}</tbody></table></div><p class="note ds-print-hidden" data-astro-cid-5wqubv3u>{{ .Note }}</p></div><script type="module" src="/_astro/HeatmapIsland.astro_astro_type_script_index_0_lang.Bkbkcf-c.js"></script>{{ end }}
