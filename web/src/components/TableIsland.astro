---
import type { Bracket, Cell, Role, StaticChampion, Tier } from '../types/agg';
import type { TierList } from '../types/agg';
import { cellAvailability, type CellAvailability } from '../lib/artifacts';
import { integer, percent, plusMinus } from '../lib/format';
import { ROLES, roleLabel, roleSlug } from '../lib/roles';
import TierBadge from './TierBadge.astro';

interface Props {
  tierList: TierList;
  champions: StaticChampion[];
  role?: Role; // undefined: every role in one table
  initialSortKey?: string; // default: 'tier'
  initialSortDir?: 'asc' | 'desc'; // default: 'desc'
}

const { tierList, champions, role, initialSortKey = 'tier', initialSortDir = 'desc' } = Astro.props;

// The strings a withheld rate reads as. They are the ones lib/rows.ts uses for
// the same cells in static tables, so one rule reads the same everywhere; the
// rule itself (lib/artifacts.cellAvailability) is imported rather than restated.
const WITHHELD = 'withheld';
const NO_SAMPLE = 'no sample';
const unavailableLabel = (availability: CellAvailability): string =>
  availability === 'no-sample' ? NO_SAMPLE : WITHHELD;

const TIER_RANK: Record<Tier, number> = { 'S+': 6, S: 5, A: 4, B: 3, C: 2, D: 1 };

const BRACKET_LABEL: Record<Bracket, string> = {
  all: 'all ranks',
  emerald_plus: 'Emerald and above',
  platinum_plus: 'Platinum and above',
  diamond_plus: 'Diamond and above',
  master_plus: 'Master and above',
};

// The id is derived from the props rather than from a counter: Astro runs this
// frontmatter once per render, so a counter would restart at 1 and two islands
// on one page would collide.
const uid = `ti-${role ? roleSlug(role) : 'all'}-${tierList.patch}-${tierList.bracket}`;

const cells = (role ? tierList.cells.filter((cell) => cell.role === role) : tierList.cells).slice();

const championById = new Map(champions.map((champion) => [champion.id, champion]));
const roleIndex = (value: Role) => ROLES.indexOf(value);

type ColumnDef = { key: string; label: string; numeric: boolean };

const columns: ColumnDef[] = [
  { key: 'champion', label: 'Champion', numeric: false },
  ...(role === undefined ? [{ key: 'role', label: 'Role', numeric: false }] : []),
  { key: 'tier', label: 'Tier', numeric: false },
  { key: 'n', label: 'Games (n)', numeric: true },
  { key: 'win_rate', label: 'Win rate', numeric: true },
  { key: 'pick_rate', label: 'Pick rate', numeric: true },
  { key: 'ban_rate', label: 'Ban rate', numeric: true },
  { key: 'ci95', label: '95% interval', numeric: true },
];

const sortKey = columns.some((column) => column.key === initialSortKey) ? initialSortKey : 'tier';
const sortDir = initialSortDir === 'asc' ? 'asc' : 'desc';
const labelOf = (key: string) => columns.find((column) => column.key === key)?.label ?? key;

interface RowModel {
  id: number;
  role: Role;
  name: string;
  slug: string;
  icon: string;
  href: string;
  tier: Tier;
  n: number;
  availability: CellAvailability;
  unavailable: string;
  winRate: number;
  pickRate: number;
  banRate: number;
  ci95: number;
  values: Record<string, number | string | null>;
}

// A value that may not be published sorts as missing rather than as zero, which
// is the same rule DataTable applies to a null cell.
const rate = (value: number, availability: CellAvailability): number | null =>
  availability === 'published' ? value : null;

const rows: RowModel[] = cells.map((cell: Cell) => {
  const champion = championById.get(cell.champion_id);
  const name = champion?.name ?? `Champion ${cell.champion_id}`;
  const slug = champion?.slug ?? String(cell.champion_id);
  const availability = cellAvailability(cell, tierList.min_cell_n);
  return {
    id: cell.champion_id,
    role: cell.role,
    name,
    slug,
    icon: champion?.icon ?? '',
    href: role ? `/champions/${slug}/${roleSlug(role)}` : `/champions/${slug}`,
    tier: cell.tier,
    n: cell.n,
    availability,
    unavailable: unavailableLabel(availability),
    winRate: cell.win_rate,
    pickRate: cell.pick_rate,
    banRate: cell.ban_rate,
    ci95: cell.ci95_half_width,
    values: {
      champion: name,
      role: roleIndex(cell.role),
      tier: TIER_RANK[cell.tier],
      n: cell.n,
      win_rate: rate(cell.win_rate, availability),
      pick_rate: rate(cell.pick_rate, availability),
      ban_rate: rate(cell.ban_rate, availability),
      ci95: rate(cell.ci95_half_width, availability),
    },
  };
});

const direction = sortDir === 'asc' ? 1 : -1;
const ordered = [...rows].sort((left, right) => {
  const a = left.values[sortKey] ?? null;
  const b = right.values[sortKey] ?? null;
  if (a === null || b === null) {
    if (a !== b) return a === null ? 1 : -1;
  } else if (typeof a === 'number' && typeof b === 'number') {
    if (a !== b) return a < b ? -direction : direction;
  } else if (a !== b) {
    const collated = String(a).localeCompare(String(b), 'en');
    if (collated !== 0) return collated < 0 ? -direction : direction;
  }
  // Ties keep a deterministic order so the client's first re-sort cannot drift
  // from the server's order: busiest first, then alphabetically.
  if (left.n !== right.n) return right.n - left.n;
  return left.name.localeCompare(right.name, 'en');
});

const caption =
  `Champion tier list for ${role ? roleLabel(role) : 'every role'}, patch ${tierList.patch}, ` +
  `${BRACKET_LABEL[tierList.bracket]}. Rates are published only when the cell has at least ` +
  `n = ${integer(tierList.min_cell_n)} games.`;
const statusText = `Showing ${ordered.length} of ${ordered.length} rows, sorted by ${labelOf(sortKey)}, ${
  sortDir === 'asc' ? 'ascending' : 'descending'
}.`;
const sortValue = (row: RowModel, key: string) => {
  const value = row.values[key];
  return value === null || value === undefined ? '' : String(value);
};
---

<div class="island" data-island="table">
  <div class="controls ds-print-hidden" data-ti-controls hidden>
    <p class="field">
      <label for={`${uid}-filter`}>Filter champions</label>
      <input id={`${uid}-filter`} type="search" data-ti-filter autocomplete="off" />
    </p>
    <p class="field">
      <label for={`${uid}-sort`}>Sort by</label>
      <select id={`${uid}-sort`} data-ti-sort>
        {
          columns.map((column) => (
            <option value={column.key} selected={column.key === sortKey ? true : undefined}>
              {column.label}
            </option>
          ))
        }
      </select>
    </p>
    <button
      type="button"
      class="toggle"
      data-ti-dir
      data-dir={sortDir}
      aria-label={`Sort direction: ${sortDir === 'asc' ? 'ascending' : 'descending'}. Activate to reverse.`}
    >
      {sortDir === 'asc' ? 'Ascending' : 'Descending'}
    </button>
  </div>

  <p class="status ds-print-hidden" data-ti-status role="status">{statusText}</p>

  <div class="wrap">
    <table>
      <caption>{caption}</caption>
      <thead>
        <tr>
          {
            columns.map((column) => (
              <th
                scope="col"
                data-col={column.key}
                aria-sort={
                  column.key === sortKey ? (sortDir === 'asc' ? 'ascending' : 'descending') : undefined
                }
                class={column.numeric ? 'num' : undefined}
              >
                {column.label}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          ordered.length === 0 ? (
            <tr>
              <td colspan={columns.length} class="empty">
                No champion has a published cell for this selection.
              </td>
            </tr>
          ) : (
            ordered.map((row) => (
              <tr
                data-search={`${row.name} ${roleLabel(row.role)}`.toLowerCase()}
                data-v-champion={sortValue(row, 'champion')}
                data-v-role={sortValue(row, 'role')}
                data-v-tier={sortValue(row, 'tier')}
                data-v-n={sortValue(row, 'n')}
                data-v-win_rate={sortValue(row, 'win_rate')}
                data-v-pick_rate={sortValue(row, 'pick_rate')}
                data-v-ban_rate={sortValue(row, 'ban_rate')}
                data-v-ci95={sortValue(row, 'ci95')}
              >
                <td class="champion">
                  {row.icon.startsWith('http') && (
                    <img src={row.icon} alt="" width="24" height="24" loading="lazy" decoding="async" />
                  )}
                  <a class="name" href={row.href}>
                    {row.name}
                  </a>
                </td>
                {role === undefined && <td>{roleLabel(row.role)}</td>}
                <td class="tier-cell">
                  <TierBadge tier={row.tier} />
                </td>
                <td class="num">{integer(row.n)}</td>
                {row.availability === 'published' ? (
                  <>
                    <td class="num">{percent(row.winRate)}</td>
                    <td class="num">{percent(row.pickRate)}</td>
                    <td class="num">{percent(row.banRate)}</td>
                    <td class="num ci">{plusMinus(row.ci95)}</td>
                  </>
                ) : (
                  <>
                    <td class="num unavailable">{row.unavailable}</td>
                    <td class="num unavailable">{row.unavailable}</td>
                    <td class="num unavailable">{row.unavailable}</td>
                    <td class="num unavailable">{row.unavailable}</td>
                  </>
                )}
              </tr>
            ))
          )
        }
      </tbody>
    </table>
  </div>

  <p class="note ds-print-hidden">
    A rate is published only when its cell has at least n = {integer(tierList.min_cell_n)} games; thinner
    cells read &ldquo;{WITHHELD}&rdquo; and show their count only.
    {
      tierList.suppressed_cells > 0 && (
        <> {integer(tierList.suppressed_cells)} further cells were withheld for being below the threshold.</>
      )
    }
  </p>
</div>

<script>
  // Only the loader runs with the page. The runtime is imported once the island
  // is about to become visible, so a page whose table is never reached never
  // downloads it. What it then does is additive: the markup above is already
  // the complete, correct table.
  import { startIslands } from './island-boot.client.ts';

  startIslands(
    '[data-island="table"]',
    () => import('./table-island.client.ts'),
    (module) => module.initTableIsland,
  );
</script>

<style>
  .island {
    margin: 0 0 var(--space-5);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-2) var(--space-3);
    margin: 0 0 var(--space-2);
    padding: var(--space-2) var(--space-3);
    background-color: var(--bg-light);
    border: var(--border-width) solid var(--hairline);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin: 0;
    font-size: var(--fs-xs);
  }

  label {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  input,
  select {
    padding: 0.2rem 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--primary-color);
    background-color: var(--bg-color);
    border: var(--border-width) solid var(--primary-color);
  }

  .toggle {
    padding: 0.3rem 0.9rem;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--text-on-dark);
    background-color: var(--accent-color);
    border: var(--border-width) solid var(--accent-color);
    border-radius: var(--radius-btn);
    cursor: pointer;
  }

  .toggle:hover {
    color: var(--primary-color);
    background-color: var(--text-on-dark);
  }

  .status,
  .note {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .note {
    margin-top: var(--space-2);
    max-width: 70ch;
  }

  .wrap {
    overflow-x: auto;
    max-width: 100%;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-sm);
    line-height: var(--line-tight);
  }

  caption {
    padding: 0 0 var(--space-2);
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--text-color);
    text-align: left;
  }

  th {
    padding: var(--row-pad-y) var(--row-pad-x);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-align: left;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-on-dark);
    background-color: var(--primary-color);
    white-space: nowrap;
  }

  td {
    padding: var(--row-pad-y) var(--row-pad-x);
    vertical-align: baseline;
    border-bottom: 1px solid var(--hairline);
  }

  tbody tr:nth-child(even) td {
    background-color: var(--stripe);
  }

  .num {
    text-align: right;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }

  .unavailable {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    font-style: italic;
  }

  .champion {
    white-space: nowrap;
  }

  .champion img {
    width: 24px;
    height: 24px;
    margin-right: 0.4rem;
    vertical-align: middle;
    border: 1px solid var(--hairline);
    background-color: var(--bg-light);
  }

  .name {
    color: var(--accent-color);
    text-decoration: none;
  }

  .name:hover {
    color: var(--primary-color);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .tier-cell {
    white-space: nowrap;
  }

  .empty {
    padding: var(--space-4) var(--row-pad-x);
    color: var(--text-muted);
  }

  @media print {
    th {
      color: var(--print-ink);
      background-color: transparent;
      border-bottom: var(--border-width) solid var(--print-ink);
    }

    tbody tr:nth-child(even) td {
      background-color: transparent;
    }
  }
</style>
